{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "QuranTrack",
  "version": "1.3.1",
  "identifier": "com.qurantrack.desktop",

  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },

  "app": {
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://localhost:8000 https://*.supabase.co https://fonts.googleapis.com https://fonts.gstatic.com https://github.com https://api.github.com",
        "font-src": "'self' asset: http://asset.localhost https://fonts.gstatic.com",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'unsafe-inline' 'self' https://fonts.googleapis.com"
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "QuranTrack",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },

  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "quran-backend"
    ],
    "createUpdaterArtifacts": true,
    "resources": [],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  },

  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "endpoints": [
        "https://github.com/Hamz115/Quran_App/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2MzMyNzkwNDVDN0REOEQKUldTTjNjZEZrQ2N6MWp4cjZWR0gwU04xNlJFM1QyV0dGcnZ3WGQxeVI4RWRFQ29md0NSaVNZeGgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
