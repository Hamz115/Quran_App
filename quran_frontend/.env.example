VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Optional: versioned static Quran asset base (works in Vite, S3, and CloudFront)
VITE_QURAN_DATA_BASE=/quran-data/v1
# Enable only inside the packaged Tauri build; normal web/PWA builds stay Supabase-only
VITE_ENABLE_LOCAL_SIDECAR=false
