{"data":{"number":81,"name":"سُورَةُ التَّكۡوِيرِ","englishName":"At-Takwir","englishNameTranslation":"The Overthrowing","numberOfAyahs":29,"revelationType":"Meccan","ayahs":[{"number":81001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ إِذَا ٱلشَّمۡسُ كُوِّرَتۡ\n","numberInSurah":1},{"number":81002,"text":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ\n","numberInSurah":2},{"number":81003,"text":"وَإِذَا ٱلۡجِبَالُ سُیِّرَتۡ\n","numberInSurah":3},{"number":81004,"text":"وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ\n","numberInSurah":4},{"number":81005,"text":"وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ\n","numberInSurah":5},{"number":81006,"text":"وَإِذَا ٱلۡبِحَارُ سُجِّرَتۡ\n","numberInSurah":6},{"number":81007,"text":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ\n","numberInSurah":7},{"number":81008,"text":"وَإِذَا ٱلۡمَوۡءُۥدَةُ سُىِٕلَتۡ\n","numberInSurah":8},{"number":81009,"text":"بِأَیِّ ذَنۢبࣲ قُتِلَتۡ\n","numberInSurah":9},{"number":81010,"text":"وَإِذَا ٱلصُّحُفُ نُشِرَتۡ\n","numberInSurah":10},{"number":81011,"text":"وَإِذَا ٱلسَّمَاۤءُ كُشِطَتۡ\n","numberInSurah":11},{"number":81012,"text":"وَإِذَا ٱلۡجَحِیمُ سُعِّرَتۡ\n","numberInSurah":12},{"number":81013,"text":"وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ\n","numberInSurah":13},{"number":81014,"text":"عَلِمَتۡ نَفۡسࣱ مَّاۤ أَحۡضَرَتۡ\n","numberInSurah":14},{"number":81015,"text":"فَلَاۤ أُقۡسِمُ بِٱلۡخُنَّسِ\n","numberInSurah":15},{"number":81016,"text":"ٱلۡجَوَارِ ٱلۡكُنَّسِ\n","numberInSurah":16},{"number":81017,"text":"وَٱلَّیۡلِ إِذَا عَسۡعَسَ\n","numberInSurah":17},{"number":81018,"text":"وَٱلصُّبۡحِ إِذَا تَنَفَّسَ\n","numberInSurah":18},{"number":81019,"text":"إِنَّهُۥ لَقَوۡلُ رَسُولࣲ كَرِیمࣲ\n","numberInSurah":19},{"number":81020,"text":"ذِی قُوَّةٍ عِندَ ذِی ٱلۡعَرۡشِ مَكِینࣲ\n","numberInSurah":20},{"number":81021,"text":"مُّطَاعࣲ ثَمَّ أَمِینࣲ\n","numberInSurah":21},{"number":81022,"text":"وَمَا صَاحِبُكُم بِمَجۡنُونࣲ\n","numberInSurah":22},{"number":81023,"text":"وَلَقَدۡ رَءَاهُ بِٱلۡأُفُقِ ٱلۡمُبِینِ\n","numberInSurah":23},{"number":81024,"text":"وَمَا هُوَ عَلَى ٱلۡغَیۡبِ بِضَنِینࣲ\n","numberInSurah":24},{"number":81025,"text":"وَمَا هُوَ بِقَوۡلِ شَیۡطَـٰنࣲ رَّجِیمࣲ\n","numberInSurah":25},{"number":81026,"text":"فَأَیۡنَ تَذۡهَبُونَ\n","numberInSurah":26},{"number":81027,"text":"إِنۡ هُوَ إِلَّا ذِكۡرࣱ لِّلۡعَـٰلَمِینَ\n","numberInSurah":27},{"number":81028,"text":"لِمَن شَاۤءَ مِنكُمۡ أَن یَسۡتَقِیمَ\n","numberInSurah":28},{"number":81029,"text":"وَمَا تَشَاۤءُونَ إِلَّاۤ أَن یَشَاۤءَ ٱللَّهُ رَبُّ ٱلۡعَـٰلَمِینَ\n","numberInSurah":29}]}}