{"data":{"number":101,"name":"سُورَةُ القَارِعَةِ","englishName":"Al-Qaari'a","englishNameTranslation":"The Calamity","numberOfAyahs":11,"revelationType":"Meccan","ayahs":[{"number":101001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ ٱلۡقَارِعَةُ\n","numberInSurah":1},{"number":101002,"text":"مَا ٱلۡقَارِعَةُ\n","numberInSurah":2},{"number":101003,"text":"وَمَاۤ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ\n","numberInSurah":3},{"number":101004,"text":"یَوۡمَ یَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ\n","numberInSurah":4},{"number":101005,"text":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ\n","numberInSurah":5},{"number":101006,"text":"فَأَمَّا مَن ثَقُلَتۡ مَوَ ٰ⁠زِینُهُۥ\n","numberInSurah":6},{"number":101007,"text":"فَهُوَ فِی عِیشَةࣲ رَّاضِیَةࣲ\n","numberInSurah":7},{"number":101008,"text":"وَأَمَّا مَنۡ خَفَّتۡ مَوَ ٰ⁠زِینُهُۥ\n","numberInSurah":8},{"number":101009,"text":"فَأُمُّهُۥ هَاوِیَةࣱ\n","numberInSurah":9},{"number":101010,"text":"وَمَاۤ أَدۡرَىٰكَ مَا هِیَهۡ\n","numberInSurah":10},{"number":101011,"text":"نَارٌ حَامِیَةُۢ\n","numberInSurah":11}]}}