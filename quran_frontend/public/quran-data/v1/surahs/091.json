{"data":{"number":91,"name":"سُورَةُ الشَّمۡسِ","englishName":"Ash-Shams","englishNameTranslation":"The Sun","numberOfAyahs":15,"revelationType":"Meccan","ayahs":[{"number":91001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلشَّمۡسِ وَضُحَىٰهَا\n","numberInSurah":1},{"number":91002,"text":"وَٱلۡقَمَرِ إِذَا تَلَىٰهَا\n","numberInSurah":2},{"number":91003,"text":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا\n","numberInSurah":3},{"number":91004,"text":"وَٱلَّیۡلِ إِذَا یَغۡشَىٰهَا\n","numberInSurah":4},{"number":91005,"text":"وَٱلسَّمَاۤءِ وَمَا بَنَىٰهَا\n","numberInSurah":5},{"number":91006,"text":"وَٱلۡأَرۡضِ وَمَا طَحَىٰهَا\n","numberInSurah":6},{"number":91007,"text":"وَنَفۡسࣲ وَمَا سَوَّىٰهَا\n","numberInSurah":7},{"number":91008,"text":"فَأَلۡهَمَهَا فُجُورَهَا وَتَقۡوَىٰهَا\n","numberInSurah":8},{"number":91009,"text":"قَدۡ أَفۡلَحَ مَن زَكَّىٰهَا\n","numberInSurah":9},{"number":91010,"text":"وَقَدۡ خَابَ مَن دَسَّىٰهَا\n","numberInSurah":10},{"number":91011,"text":"كَذَّبَتۡ ثَمُودُ بِطَغۡوَىٰهَاۤ\n","numberInSurah":11},{"number":91012,"text":"إِذِ ٱنۢبَعَثَ أَشۡقَىٰهَا\n","numberInSurah":12},{"number":91013,"text":"فَقَالَ لَهُمۡ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقۡیَـٰهَا\n","numberInSurah":13},{"number":91014,"text":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمۡدَمَ عَلَیۡهِمۡ رَبُّهُم بِذَنۢبِهِمۡ فَسَوَّىٰهَا\n","numberInSurah":14},{"number":91015,"text":"وَلَا یَخَافُ عُقۡبَـٰهَا\n","numberInSurah":15}]}}