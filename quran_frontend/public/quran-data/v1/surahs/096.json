{"data":{"number":96,"name":"سُورَةُ العَلَقِ","englishName":"Al-Alaq","englishNameTranslation":"The Clot","numberOfAyahs":19,"revelationType":"Meccan","ayahs":[{"number":96001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِی خَلَقَ\n","numberInSurah":1},{"number":96002,"text":"خَلَقَ ٱلۡإِنسَـٰنَ مِنۡ عَلَقٍ\n","numberInSurah":2},{"number":96003,"text":"ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ\n","numberInSurah":3},{"number":96004,"text":"ٱلَّذِی عَلَّمَ بِٱلۡقَلَمِ\n","numberInSurah":4},{"number":96005,"text":"عَلَّمَ ٱلۡإِنسَـٰنَ مَا لَمۡ یَعۡلَمۡ\n","numberInSurah":5},{"number":96006,"text":"كَلَّاۤ إِنَّ ٱلۡإِنسَـٰنَ لَیَطۡغَىٰۤ\n","numberInSurah":6},{"number":96007,"text":"أَن رَّءَاهُ ٱسۡتَغۡنَىٰۤ\n","numberInSurah":7},{"number":96008,"text":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰۤ\n","numberInSurah":8},{"number":96009,"text":"أَرَءَیۡتَ ٱلَّذِی یَنۡهَىٰ\n","numberInSurah":9},{"number":96010,"text":"عَبۡدًا إِذَا صَلَّىٰۤ\n","numberInSurah":10},{"number":96011,"text":"أَرَءَیۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰۤ\n","numberInSurah":11},{"number":96012,"text":"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰۤ\n","numberInSurah":12},{"number":96013,"text":"أَرَءَیۡتَ إِن كَذَّبَ وَتَوَلَّىٰۤ\n","numberInSurah":13},{"number":96014,"text":"أَلَمۡ یَعۡلَم بِأَنَّ ٱللَّهَ یَرَىٰ\n","numberInSurah":14},{"number":96015,"text":"كَلَّا لَىِٕن لَّمۡ یَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِیَةِ\n","numberInSurah":15},{"number":96016,"text":"نَاصِیَةࣲ كَـٰذِبَةٍ خَاطِئَةࣲ\n","numberInSurah":16},{"number":96017,"text":"فَلۡیَدۡعُ نَادِیَهُۥ\n","numberInSurah":17},{"number":96018,"text":"سَنَدۡعُ ٱلزَّبَانِیَةَ\n","numberInSurah":18},{"number":96019,"text":"كَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡ وَٱقۡتَرِب ۩\n","numberInSurah":19}]}}