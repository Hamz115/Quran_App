{"data":{"number":84,"name":"سُورَةُ الانشِقَاقِ","englishName":"Al-Inshiqaaq","englishNameTranslation":"The Splitting Open","numberOfAyahs":25,"revelationType":"Meccan","ayahs":[{"number":84001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ إِذَا ٱلسَّمَاۤءُ ٱنشَقَّتۡ\n","numberInSurah":1},{"number":84002,"text":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ\n","numberInSurah":2},{"number":84003,"text":"وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ\n","numberInSurah":3},{"number":84004,"text":"وَأَلۡقَتۡ مَا فِیهَا وَتَخَلَّتۡ\n","numberInSurah":4},{"number":84005,"text":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ\n","numberInSurah":5},{"number":84006,"text":"یَـٰۤأَیُّهَا ٱلۡإِنسَـٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحࣰا فَمُلَـٰقِیهِ\n","numberInSurah":6},{"number":84007,"text":"فَأَمَّا مَنۡ أُوتِیَ كِتَـٰبَهُۥ بِیَمِینِهِۦ\n","numberInSurah":7},{"number":84008,"text":"فَسَوۡفَ یُحَاسَبُ حِسَابࣰا یَسِیرࣰا\n","numberInSurah":8},{"number":84009,"text":"وَیَنقَلِبُ إِلَىٰۤ أَهۡلِهِۦ مَسۡرُورࣰا\n","numberInSurah":9},{"number":84010,"text":"وَأَمَّا مَنۡ أُوتِیَ كِتَـٰبَهُۥ وَرَاۤءَ ظَهۡرِهِۦ\n","numberInSurah":10},{"number":84011,"text":"فَسَوۡفَ یَدۡعُوا۟ ثُبُورࣰا\n","numberInSurah":11},{"number":84012,"text":"وَیَصۡلَىٰ سَعِیرًا\n","numberInSurah":12},{"number":84013,"text":"إِنَّهُۥ كَانَ فِیۤ أَهۡلِهِۦ مَسۡرُورًا\n","numberInSurah":13},{"number":84014,"text":"إِنَّهُۥ ظَنَّ أَن لَّن یَحُورَ\n","numberInSurah":14},{"number":84015,"text":"بَلَىٰۤۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِیرࣰا\n","numberInSurah":15},{"number":84016,"text":"فَلَاۤ أُقۡسِمُ بِٱلشَّفَقِ\n","numberInSurah":16},{"number":84017,"text":"وَٱلَّیۡلِ وَمَا وَسَقَ\n","numberInSurah":17},{"number":84018,"text":"وَٱلۡقَمَرِ إِذَا ٱتَّسَقَ\n","numberInSurah":18},{"number":84019,"text":"لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقࣲ\n","numberInSurah":19},{"number":84020,"text":"فَمَا لَهُمۡ لَا یُؤۡمِنُونَ\n","numberInSurah":20},{"number":84021,"text":"وَإِذَا قُرِئَ عَلَیۡهِمُ ٱلۡقُرۡءَانُ لَا یَسۡجُدُونَ ۩\n","numberInSurah":21},{"number":84022,"text":"بَلِ ٱلَّذِینَ كَفَرُوا۟ یُكَذِّبُونَ\n","numberInSurah":22},{"number":84023,"text":"وَٱللَّهُ أَعۡلَمُ بِمَا یُوعُونَ\n","numberInSurah":23},{"number":84024,"text":"فَبَشِّرۡهُم بِعَذَابٍ أَلِیمٍ\n","numberInSurah":24},{"number":84025,"text":"إِلَّا ٱلَّذِینَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمۡ أَجۡرٌ غَیۡرُ مَمۡنُونِۭ\n","numberInSurah":25}]}}