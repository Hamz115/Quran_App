{"data":{"number":88,"name":"سُورَةُ الغَاشِيَةِ","englishName":"Al-Ghaashiya","englishNameTranslation":"The Overwhelming","numberOfAyahs":26,"revelationType":"Meccan","ayahs":[{"number":88001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ هَلۡ أَتَىٰكَ حَدِیثُ ٱلۡغَـٰشِیَةِ\n","numberInSurah":1},{"number":88002,"text":"وُجُوهࣱ یَوۡمَىِٕذٍ خَـٰشِعَةٌ\n","numberInSurah":2},{"number":88003,"text":"عَامِلَةࣱ نَّاصِبَةࣱ\n","numberInSurah":3},{"number":88004,"text":"تَصۡلَىٰ نَارًا حَامِیَةࣰ\n","numberInSurah":4},{"number":88005,"text":"تُسۡقَىٰ مِنۡ عَیۡنٍ ءَانِیَةࣲ\n","numberInSurah":5},{"number":88006,"text":"لَّیۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِیعࣲ\n","numberInSurah":6},{"number":88007,"text":"لَّا یُسۡمِنُ وَلَا یُغۡنِی مِن جُوعࣲ\n","numberInSurah":7},{"number":88008,"text":"وُجُوهࣱ یَوۡمَىِٕذࣲ نَّاعِمَةࣱ\n","numberInSurah":8},{"number":88009,"text":"لِّسَعۡیِهَا رَاضِیَةࣱ\n","numberInSurah":9},{"number":88010,"text":"فِی جَنَّةٍ عَالِیَةࣲ\n","numberInSurah":10},{"number":88011,"text":"لَّا تَسۡمَعُ فِیهَا لَـٰغِیَةࣰ\n","numberInSurah":11},{"number":88012,"text":"فِیهَا عَیۡنࣱ جَارِیَةࣱ\n","numberInSurah":12},{"number":88013,"text":"فِیهَا سُرُرࣱ مَّرۡفُوعَةࣱ\n","numberInSurah":13},{"number":88014,"text":"وَأَكۡوَابࣱ مَّوۡضُوعَةࣱ\n","numberInSurah":14},{"number":88015,"text":"وَنَمَارِقُ مَصۡفُوفَةࣱ\n","numberInSurah":15},{"number":88016,"text":"وَزَرَابِیُّ مَبۡثُوثَةٌ\n","numberInSurah":16},{"number":88017,"text":"أَفَلَا یَنظُرُونَ إِلَى ٱلۡإِبِلِ كَیۡفَ خُلِقَتۡ\n","numberInSurah":17},{"number":88018,"text":"وَإِلَى ٱلسَّمَاۤءِ كَیۡفَ رُفِعَتۡ\n","numberInSurah":18},{"number":88019,"text":"وَإِلَى ٱلۡجِبَالِ كَیۡفَ نُصِبَتۡ\n","numberInSurah":19},{"number":88020,"text":"وَإِلَى ٱلۡأَرۡضِ كَیۡفَ سُطِحَتۡ\n","numberInSurah":20},{"number":88021,"text":"فَذَكِّرۡ إِنَّمَاۤ أَنتَ مُذَكِّرࣱ\n","numberInSurah":21},{"number":88022,"text":"لَّسۡتَ عَلَیۡهِم بِمُصَیۡطِرٍ\n","numberInSurah":22},{"number":88023,"text":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ\n","numberInSurah":23},