{"data":{"number":92,"name":"سُورَةُ اللَّيۡلِ","englishName":"Al-Lail","englishNameTranslation":"The Night","numberOfAyahs":21,"revelationType":"Meccan","ayahs":[{"number":92001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلَّیۡلِ إِذَا یَغۡشَىٰ\n","numberInSurah":1},{"number":92002,"text":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ\n","numberInSurah":2},{"number":92003,"text":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰۤ\n","numberInSurah":3},{"number":92004,"text":"إِنَّ سَعۡیَكُمۡ لَشَتَّىٰ\n","numberInSurah":4},{"number":92005,"text":"فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ\n","numberInSurah":5},{"number":92006,"text":"وَصَدَّقَ بِٱلۡحُسۡنَىٰ\n","numberInSurah":6},{"number":92007,"text":"فَسَنُیَسِّرُهُۥ لِلۡیُسۡرَىٰ\n","numberInSurah":7},{"number":92008,"text":"وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ\n","numberInSurah":8},{"number":92009,"text":"وَكَذَّبَ بِٱلۡحُسۡنَىٰ\n","numberInSurah":9},{"number":92010,"text":"فَسَنُیَسِّرُهُۥ لِلۡعُسۡرَىٰ\n","numberInSurah":10},{"number":92011,"text":"وَمَا یُغۡنِی عَنۡهُ مَالُهُۥۤ إِذَا تَرَدَّىٰۤ\n","numberInSurah":11},{"number":92012,"text":"إِنَّ عَلَیۡنَا لَلۡهُدَىٰ\n","numberInSurah":12},{"number":92013,"text":"وَإِنَّ لَنَا لَلۡـَٔاخِرَةَ وَٱلۡأُولَىٰ\n","numberInSurah":13},{"number":92014,"text":"فَأَنذَرۡتُكُمۡ نَارࣰا تَلَظَّىٰ\n","numberInSurah":14},{"number":92015,"text":"لَا یَصۡلَىٰهَاۤ إِلَّا ٱلۡأَشۡقَى\n","numberInSurah":15},{"number":92016,"text":"ٱلَّذِی كَذَّبَ وَتَوَلَّىٰ\n","numberInSurah":16},{"number":92017,"text":"وَسَیُجَنَّبُهَا ٱلۡأَتۡقَى\n","numberInSurah":17},{"number":92018,"text":"ٱلَّذِی یُؤۡتِی مَالَهُۥ یَتَزَكَّىٰ\n","numberInSurah":18},{"number":92019,"text":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةࣲ تُجۡزَىٰۤ\n","numberInSurah":19},{"number":92020,"text":"إِلَّا ٱبۡتِغَاۤءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ\n","numberInSurah":20},{"number":92021,"text":"وَلَسَوۡفَ یَرۡضَىٰ\n","numberInSurah":21}]}}