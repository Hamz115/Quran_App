{"data":{"number":107,"name":"سُورَةُ المَاعُونِ","englishName":"Al-Maa'un","englishNameTranslation":"Almsgiving","numberOfAyahs":7,"revelationType":"Meccan","ayahs":[{"number":107001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ أَرَءَیۡتَ ٱلَّذِی یُكَذِّبُ بِٱلدِّینِ\n","numberInSurah":1},{"number":107002,"text":"فَذَ ٰ⁠لِكَ ٱلَّذِی یَدُعُّ ٱلۡیَتِیمَ\n","numberInSurah":2},{"number":107003,"text":"وَلَا یَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِینِ\n","numberInSurah":3},{"number":107004,"text":"فَوَیۡلࣱ لِّلۡمُصَلِّینَ\n","numberInSurah":4},{"number":107005,"text":"ٱلَّذِینَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ\n","numberInSurah":5},{"number":107006,"text":"ٱلَّذِینَ هُمۡ یُرَاۤءُونَ\n","numberInSurah":6},{"number":107007,"text":"وَیَمۡنَعُونَ ٱلۡمَاعُونَ\n","numberInSurah":7}]}}