{"data":{"number":113,"name":"سُورَةُ الفَلَقِ","englishName":"Al-Falaq","englishNameTranslation":"The Dawn","numberOfAyahs":5,"revelationType":"Meccan","ayahs":[{"number":113001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ قُلۡ أَعُوذُ بِرَبِّ ٱلۡفَلَقِ\n","numberInSurah":1},{"number":113002,"text":"مِن شَرِّ مَا خَلَقَ\n","numberInSurah":2},{"number":113003,"text":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ\n","numberInSurah":3},{"number":113004,"text":"وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِی ٱلۡعُقَدِ\n","numberInSurah":4},{"number":113005,"text":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ\n","numberInSurah":5}]}}