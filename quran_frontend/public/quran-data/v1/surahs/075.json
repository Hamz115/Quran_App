{"data":{"number":75,"name":"سُورَةُ القِيَامَةِ","englishName":"Al-Qiyaama","englishNameTranslation":"The Resurrection","numberOfAyahs":40,"revelationType":"Meccan","ayahs":[{"number":75001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ لَاۤ أُقۡسِمُ بِیَوۡمِ ٱلۡقِیَـٰمَةِ\n","numberInSurah":1},{"number":75002,"text":"وَلَاۤ أُقۡسِمُ بِٱلنَّفۡسِ ٱللَّوَّامَةِ\n","numberInSurah":2},{"number":75003,"text":"أَیَحۡسَبُ ٱلۡإِنسَـٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ\n","numberInSurah":3},{"number":75004,"text":"بَلَىٰ قَـٰدِرِینَ عَلَىٰۤ أَن نُّسَوِّیَ بَنَانَهُۥ\n","numberInSurah":4},{"number":75005,"text":"بَلۡ یُرِیدُ ٱلۡإِنسَـٰنُ لِیَفۡجُرَ أَمَامَهُۥ\n","numberInSurah":5},{"number":75006,"text":"یَسۡـَٔلُ أَیَّانَ یَوۡمُ ٱلۡقِیَـٰمَةِ\n","numberInSurah":6},{"number":75007,"text":"فَإِذَا بَرِقَ ٱلۡبَصَرُ\n","numberInSurah":7},{"number":75008,"text":"وَخَسَفَ ٱلۡقَمَرُ\n","numberInSurah":8},{"number":75009,"text":"وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ\n","numberInSurah":9},{"number":75010,"text":"یَقُولُ ٱلۡإِنسَـٰنُ یَوۡمَىِٕذٍ أَیۡنَ ٱلۡمَفَرُّ\n","numberInSurah":10},{"number":75011,"text":"كَلَّا لَا وَزَرَ\n","numberInSurah":11},{"number":75012,"text":"إِلَىٰ رَبِّكَ یَوۡمَىِٕذٍ ٱلۡمُسۡتَقَرُّ\n","numberInSurah":12},{"number":75013,"text":"یُنَبَّؤُا۟ ٱلۡإِنسَـٰنُ یَوۡمَىِٕذِۭ بِمَا قَدَّمَ وَأَخَّرَ\n","numberInSurah":13},{"number":75014,"text":"بَلِ ٱلۡإِنسَـٰنُ عَلَىٰ نَفۡسِهِۦ بَصِیرَةࣱ\n","numberInSurah":14},{"number":75015,"text":"وَلَوۡ أَلۡقَىٰ مَعَاذِیرَهُۥ\n","numberInSurah":15},{"number":75016,"text":"لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦۤ\n","numberInSurah":16},{"number":75017,"text":"إِنَّ عَلَیۡنَا جَمۡعَهُۥ وَقُرۡءَانَهُۥ\n","numberInSurah":17},{"number":75018,"text":"فَإِذَا قَرَأۡنَـٰهُ فَٱتَّبِعۡ قُرۡءَانَهُۥ\n","numberInSurah":18},{"number":75019,"text":"ثُمَّ إِنَّ عَلَیۡنَا بَیَانَهُۥ\n","numberInSurah":19},{"number":75020,"text":"كَلَّا بَلۡ تُحِبُّونَ ٱلۡعَاجِلَةَ\n","numberInSurah":20},{"number":75021,"text":"وَتَذَرُونَ ٱلۡـَٔاخِرَةَ\n","numberInSurah":21},{"number":75022,"text":"وُجُوهࣱ یَوۡمَىِٕذࣲ نَّاضِرَةٌ\n","numberInSurah":22},{"number":75023,"text":"إِلَىٰ رَبِّهَا نَاظِرَةࣱ\n","numberInSurah":23},{"number":75024,"text":"وَوُجُوهࣱ یَوۡمَىِٕذِۭ بَاسِرَةࣱ\n","numberInSurah":24},{"number":75025,"text":"تَظُنُّ أَن یُفۡعَلَ بِهَا فَاقِرَةࣱ\n","numberInSurah":25},{"number":75026,"text":"كَلَّاۤ إِذَا بَلَغَتِ ٱلتَّرَاقِیَ\n","numberInSurah":26},{"number":75027,"text":"وَقِیلَ مَنۡۜ رَاقࣲ\n","numberInSurah":27},{"number":75028,"text":"وَظَنَّ أَنَّهُ ٱلۡفِرَاقُ\n","numberInSurah":28},{"number":75029,"text":"وَٱلۡتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ\n","numberInSurah":29},{"number":75030,"text":"إِلَىٰ رَبِّكَ یَوۡمَىِٕذٍ ٱلۡمَسَاقُ\n","numberInSurah":30},{"number":75031,"text":"فَلَا صَدَّقَ وَلَا صَلَّىٰ\n","numberInSurah":31},{"number":75032,"text":"وَلَـٰكِن كَذَّبَ وَتَوَلَّىٰ\n","numberInSurah":32},{"number":75033,"text":"ثُمَّ ذَهَبَ إِلَىٰۤ أَهۡلِهِۦ یَتَمَطَّىٰۤ\n","numberInSurah":33},{"number":75034,"text":"أَوۡلَىٰ لَكَ فَأَوۡلَىٰ\n","numberInSurah":34},{"number":75035,"text":"ثُمَّ أَوۡلَىٰ لَكَ فَأَوۡلَىٰۤ\n","numberInSurah":35},{"number":75036,"text":"أَیَحۡسَبُ ٱلۡإِنسَـٰنُ أَن یُتۡرَكَ سُدًى\n","numberInSurah":36},{"number":75037,"text":"أَلَمۡ یَكُ نُطۡفَةࣰ مِّن مَّنِیࣲّ یُمۡنَىٰ\n","numberInSurah":37},{"number":75038,"text":"ثُمَّ كَانَ عَلَقَةࣰ فَخَلَقَ فَسَوَّىٰ\n","numberInSurah":38},{"number":75039,"text":"فَجَعَلَ مِنۡهُ ٱلزَّوۡجَیۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰۤ\n","numberInSurah":39},{"number":75040,"text":"أَلَیۡسَ ذَ ٰ⁠لِكَ بِقَـٰدِرٍ عَلَىٰۤ أَن یُحۡـِۧیَ ٱلۡمَوۡتَىٰ\n","numberInSurah":40}]}}