{"data":{"number":109,"name":"سُورَةُ الكَافِرُونَ","englishName":"Al-Kaafiroon","englishNameTranslation":"The Disbelievers","numberOfAyahs":6,"revelationType":"Meccan","ayahs":[{"number":109001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ قُلۡ یَـٰۤأَیُّهَا ٱلۡكَـٰفِرُونَ\n","numberInSurah":1},{"number":109002,"text":"لَاۤ أَعۡبُدُ مَا تَعۡبُدُونَ\n","numberInSurah":2},{"number":109003,"text":"وَلَاۤ أَنتُمۡ عَـٰبِدُونَ مَاۤ أَعۡبُدُ\n","numberInSurah":3},{"number":109004,"text":"وَلَاۤ أَنَا۠ عَابِدࣱ مَّا عَبَدتُّمۡ\n","numberInSurah":4},{"number":109005,"text":"وَلَاۤ أَنتُمۡ عَـٰبِدُونَ مَاۤ أَعۡبُدُ\n","numberInSurah":5},{"number":109006,"text":"لَكُمۡ دِینُكُمۡ وَلِیَ دِینِ\n","numberInSurah":6}]}}