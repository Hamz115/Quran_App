{"data":{"number":114,"name":"سُورَةُ النَّاسِ","englishName":"An-Naas","englishNameTranslation":"Mankind","numberOfAyahs":6,"revelationType":"Meccan","ayahs":[{"number":114001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ\n","numberInSurah":1},{"number":114002,"text":"مَلِكِ ٱلنَّاسِ\n","numberInSurah":2},{"number":114003,"text":"إِلَـٰهِ ٱلنَّاسِ\n","numberInSurah":3},{"number":114004,"text":"مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ\n","numberInSurah":4},{"number":114005,"text":"ٱلَّذِی یُوَسۡوِسُ فِی صُدُورِ ٱلنَّاسِ\n","numberInSurah":5},{"number":114006,"text":"مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ","numberInSurah":6}]}}