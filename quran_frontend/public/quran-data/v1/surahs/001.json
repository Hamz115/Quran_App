{"data":{"number":1,"name":"سُورَةُ ٱلْفَاتِحَةِ","englishName":"Al-Faatiha","englishNameTranslation":"The Opening","numberOfAyahs":7,"revelationType":"Meccan","ayahs":[{"number":1001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ\n","numberInSurah":1},{"number":1002,"text":"ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَـٰلَمِینَ\n","numberInSurah":2},{"number":1003,"text":"ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ\n","numberInSurah":3},{"number":1004,"text":"مَـٰلِكِ یَوۡمِ ٱلدِّینِ\n","numberInSurah":4},{"number":1005,"text":"إِیَّاكَ نَعۡبُدُ وَإِیَّاكَ نَسۡتَعِینُ\n","numberInSurah":5},{"number":1006,"text":"ٱهۡدِنَا ٱلصِّرَ ٰ⁠طَ ٱلۡمُسۡتَقِیمَ\n","numberInSurah":6},{"number":1007,"text":"صِرَ ٰ⁠طَ ٱلَّذِینَ أَنۡعَمۡتَ عَلَیۡهِمۡ غَیۡرِ ٱلۡمَغۡضُوبِ عَلَیۡهِمۡ وَلَا ٱلضَّاۤلِّینَ\n","numberInSurah":7}]}}