{"data":{"number":55,"name":"سُورَةُ الرَّحۡمَٰن","englishName":"Ar-Rahmaan","englishNameTranslation":"The Beneficent","numberOfAyahs":78,"revelationType":"Medinan","ayahs":[{"number":55001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ ٱلرَّحۡمَـٰنُ\n","numberInSurah":1},{"number":55002,"text":"عَلَّمَ ٱلۡقُرۡءَانَ\n","numberInSurah":2},{"number":55003,"text":"خَلَقَ ٱلۡإِنسَـٰنَ\n","numberInSurah":3},{"number":55004,"text":"عَلَّمَهُ ٱلۡبَیَانَ\n","numberInSurah":4},{"number":55005,"text":"ٱلشَّمۡسُ وَٱلۡقَمَرُ بِحُسۡبَانࣲ\n","numberInSurah":5},{"number":55006,"text":"وَٱلنَّجۡمُ وَٱلشَّجَرُ یَسۡجُدَانِ\n","numberInSurah":6},{"number":55007,"text":"وَٱلسَّمَاۤءَ رَفَعَهَا وَوَضَعَ ٱلۡمِیزَانَ\n","numberInSurah":7},{"number":55008,"text":"أَلَّا تَطۡغَوۡا۟ فِی ٱلۡمِیزَانِ\n","numberInSurah":8},{"number":55009,"text":"وَأَقِیمُوا۟ ٱلۡوَزۡنَ بِٱلۡقِسۡطِ وَلَا تُخۡسِرُوا۟ ٱلۡمِیزَانَ\n","numberInSurah":9},{"number":55010,"text":"وَٱلۡأَرۡضَ وَضَعَهَا لِلۡأَنَامِ\n","numberInSurah":10},{"number":55011,"text":"فِیهَا فَـٰكِهَةࣱ وَٱلنَّخۡلُ ذَاتُ ٱلۡأَكۡمَامِ\n","numberInSurah":11},{"number":55012,"text":"وَٱلۡحَبُّ ذُو ٱلۡعَصۡفِ وَٱلرَّیۡحَانُ\n","numberInSurah":12},{"number":55013,"text":"فَبِأَیِّ ءَالَاۤءِ رَبِّكُمَا تُكَذِّبَانِ\n","numberInSurah":13},{"number":55014,"text":"خَلَقَ ٱلۡإِنسَـٰنَ مِن صَلۡصَـٰلࣲ كَٱلۡفَخَّارِ\n","numberInSurah":14},{"number":55015,"text":"وَخَلَقَ ٱلۡجَاۤنَّ مِن مَّارِجࣲ مِّن نَّارࣲ\n","numberInSurah":15},{"number":55016,"text":"فَبِأَیِّ ءَالَاۤءِ رَبِّكُمَا تُكَذِّبَانِ\n","numberInSurah":16},{"number":55017,"text":"رَبُّ ٱلۡمَشۡرِقَیۡنِ وَرَبُّ ٱلۡمَغۡرِبَیۡنِ\n","numberInSurah":17},{"number":55018,"text":"فَبِأَیِّ ءَالَاۤءِ رَبِّكُمَا تُكَذِّبَانِ\n","numberInSurah":18},{"number":55019,"text":"مَرَجَ ٱلۡبَحۡرَیۡنِ یَلۡتَقِیَانِ\n","numberInSurah":19},{"number":55020,"text":"بَیۡنَهُمَا بَرۡزَخࣱ لَّا یَبۡغِیَانِ\n","numberInSurah":20},{"number":55021,"text":"فَبِأَیِّ ءَالَاۤءِ رَبِّكُمَا تُكَذِّبَانِ\n","numberInSurah":21},{"number":55022,"text":"یَخۡرُجُ مِنۡهُمَا ٱللُّؤۡلُؤُ وَٱلۡمَرۡجَانُ\n","numberInSurah":22},{"number":55023,"text":"فَبِأَیِّ ءَالَاۤءِ رَبِّكُمَا تُكَذِّبَانِ\n","numberInSurah":23},{"number":55024,"text":"وَلَهُ ٱلۡجَوَارِ ٱلۡمُنشَـَٔاتُ فِی ٱلۡبَحۡرِ كَٱلۡأَعۡلَـٰمِ\n","numberInSurah":24},{"number":55025,"text":"فَبِأَیِّ ءَالَاۤءِ رَبِّكُمَا تُكَذِّبَانِ\n","numberInSurah":25},{"number":55026,"text":"كُلُّ مَنۡ عَلَیۡهَا فَانࣲ\n","numberInSurah":26},{"number":55027,"text":"وَیَبۡقَىٰ وَجۡهُ رَبِّكَ ذُو ٱلۡجَلَـٰلِ وَٱلۡإِكۡرَامِ\n","numberInSurah":27},{"number":55028,"text":"فَبِأَیِّ ءَالَاۤءِ رَبِّكُمَا تُكَذِّبَانِ\n","numberInSurah":28},{"number":55029,"text":"یَسۡـَٔلُهُۥ مَن فِی ٱلسَّمَـٰوَ ٰ⁠تِ وَٱلۡأَرۡضِۚ كُلَّ یَوۡمٍ هُوَ فِی شَأۡنࣲ\n","numberInSurah":29},{"number":55030,"text":"فَبِأَیِّ ءَالَاۤءِ رَبِّكُمَا تُكَذِّبَانِ\n","numberInSurah":30},{"number":55031,"text":"سَنَفۡرُغُ لَكُمۡ أَیُّهَ ٱلثَّقَلَانِ\n","numberInSurah":31},{"number":55032,"text":"فَبِأَیِّ ءَالَاۤءِ رَبِّكُمَا تُكَذِّبَانِ\n","numberInSurah":32},{"number":55033,"text":"یَـٰمَعۡشَرَ ٱلۡجِنِّ وَٱلۡإِنسِ إِنِ ٱسۡتَطَعۡتُمۡ أَن تَنفُذُوا۟ مِنۡ أَقۡطَارِ ٱلسَّمَـٰوَ ٰ⁠تِ وَٱلۡأَرۡضِ فَٱنفُذُوا۟ۚ لَا تَنفُذُونَ إِلَّا بِسُلۡطَـٰنࣲ\n","numberInSurah":33},{"number":55034,"text":"فَبِأَیِّ ءَالَاۤءِ رَبِّكُمَا تُكَذِّبَانِ\n","numberInSurah":34},{"number":55035,"text":"یُرۡسَلُ عَلَیۡكُمَا شُوَاظࣱ مِّن نَّارࣲ وَنُحَاسࣱ فَلَا تَنتَصِرَانِ\n","numberInSurah":35},{"number":55036,"text":"فَبِأَیِّ ءَالَاۤءِ رَبِّكُمَا تُكَذِّبَانِ\n","numberInSurah":36},{"number":55037,"text":"فَإِذَا ٱنشَقَّتِ ٱلسَّمَاۤءُ فَكَانَتۡ وَرۡدَةࣰ كَٱلدِّهَانِ\n","numberInSurah":37},{"number":55038,"text":"فَبِأَیِّ ءَالَاۤءِ رَبِّكُمَا تُكَذِّبَانِ\n","numberInSurah":38},{"number":55039,"text":"فَیَوۡمَىِٕذࣲ لَّا یُسۡـَٔلُ عَن ذَنۢبِهِۦۤ إِنسࣱ وَلَا جَاۤنࣱّ\n","numberInSurah":39},{"number":55040,"text":"فَبِأَیِّ ءَالَاۤءِ رَبِّكُمَا تُكَذِّبَانِ\n","numberInSurah":40},{"number":55041,"text":"یُعۡرَفُ ٱلۡمُجۡرِمُونَ بِ