{"data":{"number":104,"name":"سُورَةُ الهُمَزَةِ","englishName":"Al-Humaza","englishNameTranslation":"The Traducer","numberOfAyahs":9,"revelationType":"Meccan","ayahs":[{"number":104001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَیۡلࣱ لِّكُلِّ هُمَزَةࣲ لُّمَزَةٍ\n","numberInSurah":1},{"number":104002,"text":"ٱلَّذِی جَمَعَ مَالࣰا وَعَدَّدَهُۥ\n","numberInSurah":2},{"number":104003,"text":"یَحۡسَبُ أَنَّ مَالَهُۥۤ أَخۡلَدَهُۥ\n","numberInSurah":3},{"number":104004,"text":"كَلَّاۖ لَیُنۢبَذَنَّ فِی ٱلۡحُطَمَةِ\n","numberInSurah":4},{"number":104005,"text":"وَمَاۤ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ\n","numberInSurah":5},{"number":104006,"text":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ\n","numberInSurah":6},{"number":104007,"text":"ٱلَّتِی تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ\n","numberInSurah":7},{"number":104008,"text":"إِنَّهَا عَلَیۡهِم مُّؤۡصَدَةࣱ\n","numberInSurah":8},{"number":104009,"text":"فِی عَمَدࣲ مُّمَدَّدَةِۭ\n","numberInSurah":9}]}}