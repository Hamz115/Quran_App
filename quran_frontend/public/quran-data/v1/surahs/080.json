{"data":{"number":80,"name":"سُورَةُ عَبَسَ","englishName":"Abasa","englishNameTranslation":"He frowned","numberOfAyahs":42,"revelationType":"Meccan","ayahs":[{"number":80001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ عَبَسَ وَتَوَلَّىٰۤ\n","numberInSurah":1},{"number":80002,"text":"أَن جَاۤءَهُ ٱلۡأَعۡمَىٰ\n","numberInSurah":2},{"number":80003,"text":"وَمَا یُدۡرِیكَ لَعَلَّهُۥ یَزَّكَّىٰۤ\n","numberInSurah":3},{"number":80004,"text":"أَوۡ یَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰۤ\n","numberInSurah":4},{"number":80005,"text":"أَمَّا مَنِ ٱسۡتَغۡنَىٰ\n","numberInSurah":5},{"number":80006,"text":"فَأَنتَ لَهُۥ تَصَدَّىٰ\n","numberInSurah":6},{"number":80007,"text":"وَمَا عَلَیۡكَ أَلَّا یَزَّكَّىٰ\n","numberInSurah":7},{"number":80008,"text":"وَأَمَّا مَن جَاۤءَكَ یَسۡعَىٰ\n","numberInSurah":8},{"number":80009,"text":"وَهُوَ یَخۡشَىٰ\n","numberInSurah":9},{"number":80010,"text":"فَأَنتَ عَنۡهُ تَلَهَّىٰ\n","numberInSurah":10},{"number":80011,"text":"كَلَّاۤ إِنَّهَا تَذۡكِرَةࣱ\n","numberInSurah":11},{"number":80012,"text":"فَمَن شَاۤءَ ذَكَرَهُۥ\n","numberInSurah":12},{"number":80013,"text":"فِی صُحُفࣲ مُّكَرَّمَةࣲ\n","numberInSurah":13},{"number":80014,"text":"مَّرۡفُوعَةࣲ مُّطَهَّرَةِۭ\n","numberInSurah":14},{"number":80015,"text":"بِأَیۡدِی سَفَرَةࣲ\n","numberInSurah":15},{"number":80016,"text":"كِرَامِۭ بَرَرَةࣲ\n","numberInSurah":16},{"number":80017,"text":"قُتِلَ ٱلۡإِنسَـٰنُ مَاۤ أَكۡفَرَهُۥ\n","numberInSurah":17},{"number":80018,"text":"مِنۡ أَیِّ شَیۡءٍ خَلَقَهُۥ\n","numberInSurah":18},{"number":80019,"text":"مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ\n","numberInSurah":19},{"number":80020,"text":"ثُمَّ ٱلسَّبِیلَ یَسَّرَهُۥ\n","numberInSurah":20},{"number":80021,"text":"ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ\n","numberInSurah":21},{"number":80022,"text":"ثُمَّ إِذَا شَاۤءَ أَنشَرَهُۥ\n","numberInSurah":22},{"number":80023,"text":"كَلَّا لَمَّا یَقۡضِ مَاۤ أَمَرَهُۥ\n","numberInSurah":23},{"number":80024,"text":"فَلۡیَنظُرِ ٱلۡإِنسَـٰنُ إِلَىٰ طَعَامِهِۦۤ\n","numberInSurah":24},{"number":80025,"text":"أَنَّا صَبَبۡنَا ٱلۡمَاۤءَ صَبࣰّا\n","numberInSurah":25},{"number":80026,"text":"ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقࣰّا\n","numberInSurah":26},{"number":80027,"text":"فَأَنۢبَتۡنَا فِیهَا حَبࣰّا\n","numberInSurah":27},{"number":80028,"text":"وَعِنَبࣰا وَقَضۡبࣰا\n","numberInSurah":28},{"number":80029,"text":"وَزَیۡتُونࣰا وَنَخۡلࣰا\n","numberInSurah":29},{"number":80030,"text":"وَحَدَاۤىِٕقَ غُلۡبࣰا\n","numberInSurah":30},{"number":80031,"text":"وَفَـٰكِهَةࣰ وَأَبࣰّا\n","numberInSurah":31},{"number":80032,"text":"مَّتَـٰعࣰا لَّكُمۡ وَلِأَنۡعَـٰمِكُمۡ\n","numberInSurah":32},{"number":80033,"text":"فَإِذَا جَاۤءَتِ ٱلصَّاۤخَّةُ\n","numberInSurah":33},{"number":80034,"text":"یَوۡمَ یَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِیهِ\n","numberInSurah":34},{"number":80035,"text":"وَأُمِّهِۦ وَأَبِیهِ\n","numberInSurah":35},{"number":80036,"text":"وَصَـٰحِبَتِهِۦ وَبَنِیهِ\n","numberInSurah":36},{"number":80037,"text":"لِكُلِّ ٱمۡرِئࣲ مِّنۡهُمۡ یَوۡمَىِٕذࣲ شَأۡنࣱ یُغۡنِیهِ\n","numberInSurah":37},{"number":80038,"text":"وُجُوهࣱ یَوۡمَىِٕذࣲ مُّسۡفِرَةࣱ\n","numberInSurah":38},{"number":80039,"text":"ضَاحِكَةࣱ مُّسۡتَبۡشِرَةࣱ\n","numberInSurah":39},{"number":80040,"text":"وَوُجُوهࣱ یَوۡمَىِٕذٍ عَلَیۡهَا غَبَرَةࣱ\n","numberInSurah":40},{"number":80041,"text":"تَرۡهَقُهَا قَتَرَةٌ\n","numberInSurah":41},{"number":80042,"text":"أُو۟لَـٰۤىِٕكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ\n","numberInSurah":42}]}}