{"data":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa","englishNameTranslation":"The Reality","numberOfAyahs":52,"revelationType":"Meccan","ayahs":[{"number":69001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ ٱلۡحَاۤقَّةُ\n","numberInSurah":1},{"number":69002,"text":"مَا ٱلۡحَاۤقَّةُ\n","numberInSurah":2},{"number":69003,"text":"وَمَاۤ أَدۡرَىٰكَ مَا ٱلۡحَاۤقَّةُ\n","numberInSurah":3},{"number":69004,"text":"كَذَّبَتۡ ثَمُودُ وَعَادُۢ بِٱلۡقَارِعَةِ\n","numberInSurah":4},{"number":69005,"text":"فَأَمَّا ثَمُودُ فَأُهۡلِكُوا۟ بِٱلطَّاغِیَةِ\n","numberInSurah":5},{"number":69006,"text":"وَأَمَّا عَادࣱ فَأُهۡلِكُوا۟ بِرِیحࣲ صَرۡصَرٍ عَاتِیَةࣲ\n","numberInSurah":6},{"number":69007,"text":"سَخَّرَهَا عَلَیۡهِمۡ سَبۡعَ لَیَالࣲ وَثَمَـٰنِیَةَ أَیَّامٍ حُسُومࣰاۖ فَتَرَى ٱلۡقَوۡمَ فِیهَا صَرۡعَىٰ كَأَنَّهُمۡ أَعۡجَازُ نَخۡلٍ خَاوِیَةࣲ\n","numberInSurah":7},{"number":69008,"text":"فَهَلۡ تَرَىٰ لَهُم مِّنۢ بَاقِیَةࣲ\n","numberInSurah":8},{"number":69009,"text":"وَجَاۤءَ فِرۡعَوۡنُ وَمَن قَبۡلَهُۥ وَٱلۡمُؤۡتَفِكَـٰتُ بِٱلۡخَاطِئَةِ\n","numberInSurah":9},{"number":69010,"text":"فَعَصَوۡا۟ رَسُولَ رَبِّهِمۡ فَأَخَذَهُمۡ أَخۡذَةࣰ رَّابِیَةً\n","numberInSurah":10},{"number":69011,"text":"إِنَّا لَمَّا طَغَا ٱلۡمَاۤءُ حَمَلۡنَـٰكُمۡ فِی ٱلۡجَارِیَةِ\n","numberInSurah":11},{"number":69012,"text":"لِنَجۡعَلَهَا لَكُمۡ تَذۡكِرَةࣰ وَتَعِیَهَاۤ أُذُنࣱ وَ ٰ⁠عِیَةࣱ\n","numberInSurah":12},{"number":69013,"text":"فَإِذَا نُفِخَ فِی ٱلصُّورِ نَفۡخَةࣱ وَ ٰ⁠حِدَةࣱ\n","numberInSurah":13},{"number":69014,"text":"وَحُمِلَتِ ٱلۡأَرۡضُ وَٱلۡجِبَالُ فَدُكَّتَا دَكَّةࣰ وَ ٰ⁠حِدَةࣰ\n","numberInSurah":14},{"number":69015,"text":"فَیَوۡمَىِٕذࣲ وَقَعَتِ ٱلۡوَاقِعَةُ\n","numberInSurah":15},{"number":69016,"text":"وَٱنشَقَّتِ ٱلسَّمَاۤءُ فَهِیَ یَوۡمَىِٕذࣲ وَاهِیَةࣱ\n","numberInSurah":16},{"number":69017,"text":"وَٱلۡمَلَكُ عَلَىٰۤ أَرۡجَاۤىِٕهَاۚ وَیَحۡمِلُ عَرۡشَ رَبِّكَ فَوۡقَهُمۡ یَوۡمَىِٕذࣲ ثَمَـٰنِیَةࣱ\n","numberInSurah":17},{"number":69018,"text":"یَوۡمَىِٕذࣲ تُعۡرَضُونَ لَا تَخۡفَىٰ مِنكُمۡ خَافِیَةࣱ\n","numberInSurah":18},{"number":69019,"text":"فَأَمَّا مَنۡ أُوتِیَ كِتَـٰبَهُۥ بِیَمِینِهِۦ فَیَقُولُ هَاۤؤُمُ ٱقۡرَءُوا۟ كِتَـٰبِیَهۡ\n","numberInSurah":19},{"number":69020,"text":"إِنِّی ظَنَنتُ أَنِّی مُلَـٰقٍ حِسَابِیَهۡ\n","numberInSurah":20},{"number":69021,"text":"فَهُوَ فِی عِیشَةࣲ رَّاضِیَةࣲ\n","numberInSurah":21},{"number":69022,"text":"فِی جَنَّةٍ عَالِیَةࣲ\n","numberInSurah":22},{"number":69023,"text":"قُطُوفُهَا دَانِیَةࣱ\n","numberInSurah":23},{"number":69024,"text":"كُلُوا۟ وَٱشۡرَبُوا۟ هَنِیۤـَٔۢا بِمَاۤ أَسۡلَفۡتُمۡ فِی ٱلۡأَیَّامِ ٱلۡخَالِیَةِ\n","numberInSurah":24},{"number":69025,"text":"وَأَمَّا مَنۡ أُوتِیَ كِتَـٰبَهُۥ بِشِمَالِهِۦ فَیَقُولُ یَـٰلَیۡتَنِی لَمۡ أُوتَ كِتَـٰبِیَهۡ\n","numberInSurah":25},{"number":69026,"text":"وَلَمۡ أَدۡرِ مَا حِسَابِیَهۡ\n","numberInSurah":26},{"number":69027,"text":"یَـٰلَیۡتَهَا كَانَتِ ٱلۡقَاضِیَةَ\n","numberInSurah":27},{"number":69028,"text":"مَاۤ أَغۡنَىٰ عَنِّی مَالِیَهۡۜ\n","numberInSurah":28},{"number":69029,"text":"هَلَكَ عَنِّی سُلۡطَـٰنِیَهۡ\n","numberInSurah":29},{"number":69030,"text":"خُذُوهُ فَغُلُّوهُ\n","numberInSurah":30},{"number":69031,"text":"ثُمَّ ٱلۡجَحِیمَ صَلُّوهُ\n","numberInSurah":31},{"number":69032,"text":"ثُمَّ فِی سِلۡسِلَةࣲ ذَرۡعُهَا سَبۡعُونَ ذِرَاعࣰا فَٱسۡلُكُوهُ\n","numberInSurah":32},{"number":69033,"text":"إِنَّهُۥ كَانَ لَا یُؤۡمِنُ بِٱللَّهِ ٱلۡعَظِیمِ\n","numberInSurah":33},{"number":69034,"text":"وَلَا یَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِینِ\n","numberInSurah":34},{"number":69035,"text":"فَلَیۡسَ لَهُ ٱلۡیَوۡمَ هَـٰهُنَا حَمِیمࣱ\n","numberInSurah":35},{"number":69036,"text":"وَلَا طَعَامٌ إِلَّا مِنۡ غِسۡلِینࣲ\n","numberInSurah":36},{"number":69037,"text":"لَّا یَأۡكُلُهُۥۤ إِلَّا ٱلۡخَـٰطِـُٔونَ\n","numberInSurah":37},{"number":69038,"text":"فَلَاۤ أُقۡسِمُ بِمَا تُبۡصِرُونَ\n","numberInSurah":38},{"number":69039,"text":"وَمَا لَا تُبۡصِرُونَ\n","numberInSurah":39},{"number":69040,"text":"إِنَّهُۥ لَقَوۡلُ رَسُولࣲ كَرِیمࣲ\n","numberInSurah":40},{"number":69041,"text":"وَمَا هُوَ بِقَوۡلِ شَاعِرࣲۚ قَلِیلࣰا مَّا تُؤۡمِنُونَ\n","numberInSurah":41},{"number":69042,"text":"وَلَا بِقَوۡلِ كَاهِنࣲۚ قَلِیلࣰا مَّا تَذَكَّرُونَ\n","numberInSurah":42},{"number":69043,"text":"تَنزِیلࣱ مِّن رَّبِّ ٱلۡعَـٰلَمِینَ\n","numberInSurah":43},{"number":69044,"text":"وَلَوۡ تَقَوَّلَ عَلَیۡنَا بَعۡضَ ٱلۡأَقَاوِیلِ\n","numberInSurah":44},{"number":69045,"text":"لَأَخَذۡنَا مِنۡهُ بِٱلۡیَمِینِ\n","numberInSurah":45},{"number":69046,"text":"ثُمَّ لَقَطَعۡنَا مِنۡهُ ٱلۡوَتِینَ\n","numberInSurah":46},{"number":69047,"text":"فَمَا مِنكُم مِّنۡ أَحَدٍ عَنۡهُ حَـٰجِزِینَ\n","numberInSurah":47},{"number":69048,"text":"وَإِنَّهُۥ لَتَذۡكِرَةࣱ لِّلۡمُتَّقِینَ\n","numberInSurah":48},{"number":69049,"text":"وَإِنَّا لَنَعۡلَمُ أَنَّ مِنكُم مُّكَذِّبِینَ\n","numberInSurah":49},{"number":69050,"text":"وَإِنَّهُۥ لَحَسۡرَةٌ عَلَى ٱلۡكَـٰفِرِینَ\n","numberInSurah":50},{"number":69051,"text":"وَإِنَّهُۥ لَحَقُّ ٱلۡیَقِینِ\n","numberInSurah":51},{"number":69052,"text":"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِیمِ\n","numberInSurah":52}]}}