{"data":{"number":89,"name":"سُورَةُ الفَجۡرِ","englishName":"Al-Fajr","englishNameTranslation":"The Dawn","numberOfAyahs":30,"revelationType":"Meccan","ayahs":[{"number":89001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلۡفَجۡرِ\n","numberInSurah":1},{"number":89002,"text":"وَلَیَالٍ عَشۡرࣲ\n","numberInSurah":2},{"number":89003,"text":"وَٱلشَّفۡعِ وَٱلۡوَتۡرِ\n","numberInSurah":3},{"number":89004,"text":"وَٱلَّیۡلِ إِذَا یَسۡرِ\n","numberInSurah":4},{"number":89005,"text":"هَلۡ فِی ذَ ٰ⁠لِكَ قَسَمࣱ لِّذِی حِجۡرٍ\n","numberInSurah":5},{"number":89006,"text":"أَلَمۡ تَرَ كَیۡفَ فَعَلَ رَبُّكَ بِعَادٍ\n","numberInSurah":6},{"number":89007,"text":"إِرَمَ ذَاتِ ٱلۡعِمَادِ\n","numberInSurah":7},{"number":89008,"text":"ٱلَّتِی لَمۡ یُخۡلَقۡ مِثۡلُهَا فِی ٱلۡبِلَـٰدِ\n","numberInSurah":8},{"number":89009,"text":"وَثَمُودَ ٱلَّذِینَ جَابُوا۟ ٱلصَّخۡرَ بِٱلۡوَادِ\n","numberInSurah":9},{"number":89010,"text":"وَفِرۡعَوۡنَ ذِی ٱلۡأَوۡتَادِ\n","numberInSurah":10},{"number":89011,"text":"ٱلَّذِینَ طَغَوۡا۟ فِی ٱلۡبِلَـٰدِ\n","numberInSurah":11},{"number":89012,"text":"فَأَكۡثَرُوا۟ فِیهَا ٱلۡفَسَادَ\n","numberInSurah":12},{"number":89013,"text":"فَصَبَّ عَلَیۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ\n","numberInSurah":13},{"number":89014,"text":"إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ\n","numberInSurah":14},{"number":89015,"text":"فَأَمَّا ٱلۡإِنسَـٰنُ إِذَا مَا ٱبۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ فَیَقُولُ رَبِّیۤ أَكۡرَمَنِ\n","numberInSurah":15},{"number":89016,"text":"وَأَمَّاۤ إِذَا مَا ٱبۡتَلَىٰهُ فَقَدَرَ عَلَیۡهِ رِزۡقَهُۥ فَیَقُولُ رَبِّیۤ أَهَـٰنَنِ\n","numberInSurah":16},{"number":89017,"text":"كَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡیَتِیمَ\n","numberInSurah":17},{"number":89018,"text":"وَلَا تَحَـٰۤضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِینِ\n","numberInSurah":18},{"number":89019,"text":"وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلࣰا لَّمࣰّا\n","numberInSurah":19},{"number":89020,"text":"وَتُحِبُّونَ ٱلۡمَالَ حُبࣰّا جَمࣰّا\n","numberInSurah":20},{"number":89021,"text":"كَلَّاۤۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكࣰّا دَكࣰّا\n","numberInSurah":21},{"number":89022,"text":"وَجَاۤءَ رَبُّكَ وَٱلۡمَلَكُ صَفࣰّا صَفࣰّا\n","numberInSurah":22},{"number":89023,"text":"وَجِا۟یۤءَ یَوۡمَىِٕذِۭ بِجَهَنَّمَۚ یَوۡمَىِٕذࣲ یَتَذَكَّرُ ٱلۡإِنسَـٰنُ وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ\n","numberInSurah":23},{"number":89024,"text":"یَقُولُ یَـٰلَیۡتَنِی قَدَّمۡتُ لِحَیَاتِی\n","numberInSurah":24},{"number":89025,"text":"فَیَوۡمَىِٕذࣲ لَّا یُعَذِّبُ عَذَابَهُۥۤ أَحَدࣱ\n","numberInSurah":25},{"number":89026,"text":"وَلَا یُوثِقُ وَثَاقَهُۥۤ أَحَدࣱ\n","numberInSurah":26},{"number":89027,"text":"یَـٰۤأَیَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَىِٕنَّةُ\n","numberInSurah":27},{"number":89028,"text":"ٱرۡجِعِیۤ إِلَىٰ رَبِّكِ رَاضِیَةࣰ مَّرۡضِیَّةࣰ\n","numberInSurah":28},{"number":89029,"text":"فَٱدۡخُلِی فِی عِبَـٰدِی\n","numberInSurah":29},{"number":89030,"text":"وَٱدۡخُلِی جَنَّتِی\n","numberInSurah":30}]}}