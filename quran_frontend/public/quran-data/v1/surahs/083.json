{"data":{"number":83,"name":"سُورَةُ المُطَفِّفِينَ","englishName":"Al-Mutaffifin","englishNameTranslation":"Defrauding","numberOfAyahs":36,"revelationType":"Meccan","ayahs":[{"number":83001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَیۡلࣱ لِّلۡمُطَفِّفِینَ\n","numberInSurah":1},{"number":83002,"text":"ٱلَّذِینَ إِذَا ٱكۡتَالُوا۟ عَلَى ٱلنَّاسِ یَسۡتَوۡفُونَ\n","numberInSurah":2},{"number":83003,"text":"وَإِذَا كَالُوهُمۡ أَو وَّزَنُوهُمۡ یُخۡسِرُونَ\n","numberInSurah":3},{"number":83004,"text":"أَلَا یَظُنُّ أُو۟لَـٰۤىِٕكَ أَنَّهُم مَّبۡعُوثُونَ\n","numberInSurah":4},{"number":83005,"text":"لِیَوۡمٍ عَظِیمࣲ\n","numberInSurah":5},{"number":83006,"text":"یَوۡمَ یَقُومُ ٱلنَّاسُ لِرَبِّ ٱلۡعَـٰلَمِینَ\n","numberInSurah":6},{"number":83007,"text":"كَلَّاۤ إِنَّ كِتَـٰبَ ٱلۡفُجَّارِ لَفِی سِجِّینࣲ\n","numberInSurah":7},{"number":83008,"text":"وَمَاۤ أَدۡرَىٰكَ مَا سِجِّینࣱ\n","numberInSurah":8},{"number":83009,"text":"كِتَـٰبࣱ مَّرۡقُومࣱ\n","numberInSurah":9},{"number":83010,"text":"وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ\n","numberInSurah":10},{"number":83011,"text":"ٱلَّذِینَ یُكَذِّبُونَ بِیَوۡمِ ٱلدِّینِ\n","numberInSurah":11},{"number":83012,"text":"وَمَا یُكَذِّبُ بِهِۦۤ إِلَّا كُلُّ مُعۡتَدٍ أَثِیمٍ\n","numberInSurah":12},{"number":83013,"text":"إِذَا تُتۡلَىٰ عَلَیۡهِ ءَایَـٰتُنَا قَالَ أَسَـٰطِیرُ ٱلۡأَوَّلِینَ\n","numberInSurah":13},{"number":83014,"text":"كَلَّاۖ بَلۡۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ یَكۡسِبُونَ\n","numberInSurah":14},{"number":83015,"text":"كَلَّاۤ إِنَّهُمۡ عَن رَّبِّهِمۡ یَوۡمَىِٕذࣲ لَّمَحۡجُوبُونَ\n","numberInSurah":15},{"number":83016,"text":"ثُمَّ إِنَّهُمۡ لَصَالُوا۟ ٱلۡجَحِیمِ\n","numberInSurah":16},{"number":83017,"text":"ثُمَّ یُقَالُ هَـٰذَا ٱلَّذِی كُنتُم بِهِۦ تُكَذِّبُونَ\n","numberInSurah":17},{"number":83018,"text":"كَلَّاۤ إِنَّ كِتَـٰبَ ٱلۡأَبۡرَارِ لَفِی عِلِّیِّینَ\n","numberInSurah":18},{"number":83019,"text":"وَمَاۤ أَدۡرَىٰكَ مَا عِلِّیُّونَ\n","numberInSurah":19},{"number":83020,"text":"كِتَـٰبࣱ مَّرۡقُومࣱ\n","numberInSurah":20},{"number":83021,"text":"یَشۡهَدُهُ ٱلۡمُقَرَّبُونَ\n","numberInSurah":21},{"number":83022,"text":"إِنَّ ٱلۡأَبۡرَارَ لَفِی نَعِیمٍ\n","numberInSurah":22},{"number":83023,"text":"عَلَى ٱلۡأَرَاۤىِٕكِ یَنظُرُونَ\n","numberInSurah":23},{"number":83024,"text":"تَعۡرِفُ فِی وُجُوهِهِمۡ نَضۡرَةَ ٱلنَّعِیمِ\n","numberInSurah":24},{"number":83025,"text":"یُسۡقَوۡنَ مِن رَّحِیقࣲ مَّخۡتُومٍ\n","numberInSurah":25},{"number":83026,"text":"خِتَـٰمُهُۥ مِسۡكࣱۚ وَفِی ذَ ٰ⁠لِكَ فَلۡیَتَنَافَسِ ٱلۡمُتَنَـٰفِسُونَ\n","numberInSurah":26},{"number":83027,"text":"وَمِزَاجُهُۥ مِن تَسۡنِیمٍ\n","numberInSurah":27},{"number":83028,"text":"عَیۡنࣰا یَشۡرَبُ بِهَا ٱلۡمُقَرَّبُونَ\n","numberInSurah":28},{"number":83029,"text":"إِنَّ ٱلَّذِینَ أَجۡرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِینَ ءَامَنُوا۟ یَضۡحَكُونَ\n","numberInSurah":29},{"number":83030,"text":"وَإِذَا مَرُّوا۟ بِهِمۡ یَتَغَامَزُونَ\n","numberInSurah":30},{"number":83031,"text":"وَإِذَا ٱنقَلَبُوۤا۟ إِلَىٰۤ أَهۡلِهِمُ ٱنقَلَبُوا۟ فَكِهِینَ\n","numberInSurah":31},{"number":83032,"text":"وَإِذَا رَأَوۡهُمۡ قَالُوۤا۟ إِنَّ هَـٰۤؤُلَاۤءِ لَضَاۤلُّونَ\n","numberInSurah":32},{"number":83033,"text":"وَمَاۤ أُرۡسِلُوا۟ عَلَیۡهِمۡ حَـٰفِظِینَ\n","numberInSurah":33},{"number":83034,"text":"فَٱلۡیَوۡمَ ٱلَّذِینَ ءَامَنُوا۟ مِنَ ٱلۡكُفَّارِ یَضۡحَكُونَ\n","numberInSurah":34},{"number":83035,"text":"عَلَى ٱلۡأَرَاۤىِٕكِ یَنظُرُونَ\n","numberInSurah":35},{"number":83036,"text":"هَلۡ ثُوِّبَ ٱلۡكُفَّارُ مَا كَانُوا۟ یَفۡعَلُونَ\n","numberInSurah":36}]}}