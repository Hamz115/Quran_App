{"data":{"number":103,"name":"سُورَةُ العَصۡرِ","englishName":"Al-Asr","englishNameTranslation":"The Declining Day, Epoch","numberOfAyahs":3,"revelationType":"Meccan","ayahs":[{"number":103001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلۡعَصۡرِ\n","numberInSurah":1},{"number":103002,"text":"إِنَّ ٱلۡإِنسَـٰنَ لَفِی خُسۡرٍ\n","numberInSurah":2},{"number":103003,"text":"إِلَّا ٱلَّذِینَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ وَتَوَاصَوۡا۟ بِٱلۡحَقِّ وَتَوَاصَوۡا۟ بِٱلصَّبۡرِ\n","numberInSurah":3}]}}