{"data":{"number":79,"name":"سُورَةُ النَّازِعَاتِ","englishName":"An-Naazi'aat","englishNameTranslation":"Those who drag forth","numberOfAyahs":46,"revelationType":"Meccan","ayahs":[{"number":79001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلنَّـٰزِعَـٰتِ غَرۡقࣰا\n","numberInSurah":1},{"number":79002,"text":"وَٱلنَّـٰشِطَـٰتِ نَشۡطࣰا\n","numberInSurah":2},{"number":79003,"text":"وَٱلسَّـٰبِحَـٰتِ سَبۡحࣰا\n","numberInSurah":3},{"number":79004,"text":"فَٱلسَّـٰبِقَـٰتِ سَبۡقࣰا\n","numberInSurah":4},{"number":79005,"text":"فَٱلۡمُدَبِّرَ ٰ⁠تِ أَمۡرࣰا\n","numberInSurah":5},{"number":79006,"text":"یَوۡمَ تَرۡجُفُ ٱلرَّاجِفَةُ\n","numberInSurah":6},{"number":79007,"text":"تَتۡبَعُهَا ٱلرَّادِفَةُ\n","numberInSurah":7},{"number":79008,"text":"قُلُوبࣱ یَوۡمَىِٕذࣲ وَاجِفَةٌ\n","numberInSurah":8},{"number":79009,"text":"أَبۡصَـٰرُهَا خَـٰشِعَةࣱ\n","numberInSurah":9},{"number":79010,"text":"یَقُولُونَ أَءِنَّا لَمَرۡدُودُونَ فِی ٱلۡحَافِرَةِ\n","numberInSurah":10},{"number":79011,"text":"أَءِذَا كُنَّا عِظَـٰمࣰا نَّخِرَةࣰ\n","numberInSurah":11},{"number":79012,"text":"قَالُوا۟ تِلۡكَ إِذࣰا كَرَّةٌ خَاسِرَةࣱ\n","numberInSurah":12},{"number":79013,"text":"فَإِنَّمَا هِیَ زَجۡرَةࣱ وَ ٰ⁠حِدَةࣱ\n","numberInSurah":13},{"number":79014,"text":"فَإِذَا هُم بِٱلسَّاهِرَةِ\n","numberInSurah":14},{"number":79015,"text":"هَلۡ أَتَىٰكَ حَدِیثُ مُوسَىٰۤ\n","numberInSurah":15},{"number":79016,"text":"إِذۡ نَادَىٰهُ رَبُّهُۥ بِٱلۡوَادِ ٱلۡمُقَدَّسِ طُوًى\n","numberInSurah":16},{"number":79017,"text":"ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ\n","numberInSurah":17},{"number":79018,"text":"فَقُلۡ هَل لَّكَ إِلَىٰۤ أَن تَزَكَّىٰ\n","numberInSurah":18},{"number":79019,"text":"وَأَهۡدِیَكَ إِلَىٰ رَبِّكَ فَتَخۡشَىٰ\n","numberInSurah":19},{"number":79020,"text":"فَأَرَىٰهُ ٱلۡـَٔایَةَ ٱلۡكُبۡرَىٰ\n","numberInSurah":20},{"number":79021,"text":"فَكَذَّبَ وَعَصَىٰ\n","numberInSurah":21},{"number":79022,"text":"ثُمَّ أَدۡبَرَ یَسۡعَىٰ\n","numberInSurah":22},{"number":79023,"text":"فَحَشَرَ فَنَادَىٰ\n","numberInSurah":23},{"number":79024,"text":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلۡأَعۡلَىٰ\n","numberInSurah":24},{"number":79025,"text":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلۡـَٔاخِرَةِ وَٱلۡأُولَىٰۤ\n","numberInSurah":25},{"number":79026,"text":"إِنَّ فِی ذَ ٰ⁠لِكَ لَعِبۡرَةࣰ لِّمَن یَخۡشَىٰۤ\n","numberInSurah":26},{"number":79027,"text":"ءَأَنتُمۡ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَاۤءُۚ بَنَىٰهَا\n","numberInSurah":27},{"number":79028,"text":"رَفَعَ سَمۡكَهَا فَسَوَّىٰهَا\n","numberInSurah":28},{"number":79029,"text":"وَأَغۡطَشَ لَیۡلَهَا وَأَخۡرَجَ ضُحَىٰهَا\n","numberInSurah":29},{"number":79030,"text":"وَٱلۡأَرۡضَ بَعۡدَ ذَ ٰ⁠لِكَ دَحَىٰهَاۤ\n","numberInSurah":30},{"number":79031,"text":"أَخۡرَجَ مِنۡهَا مَاۤءَهَا وَمَرۡعَىٰهَا\n","numberInSurah":31},{"number":79032,"text":"وَٱلۡجِبَالَ أَرۡسَىٰهَا\n","numberInSurah":32},{"number":79033,"text":"مَتَـٰعࣰا لَّكُمۡ وَلِأَنۡعَـٰمِكُمۡ\n","numberInSurah":33},{"number":79034,"text":"فَإِذَا جَاۤءَتِ ٱلطَّاۤمَّةُ ٱلۡكُبۡرَىٰ\n","numberInSurah":34},{"number":79035,"text":"یَوۡمَ یَتَذَكَّرُ ٱلۡإِنسَـٰنُ مَا سَعَىٰ\n","numberInSurah":35},{"number":79036,"text":"وَبُرِّزَتِ ٱلۡجَحِیمُ لِمَن یَرَىٰ\n","numberInSurah":36},{"number":79037,"text":"فَأَمَّا مَن طَغَىٰ\n","numberInSurah":37},{"number":79038,"text":"وَءَاثَرَ ٱلۡحَیَوٰةَ ٱلدُّنۡیَا\n","numberInSurah":38},{"number":79039,"text":"فَإِنَّ ٱلۡجَحِیمَ هِیَ ٱلۡمَأۡوَىٰ\n","numberInSurah":39},{"number":79040,"text":"وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفۡسَ عَنِ ٱلۡهَوَىٰ\n","numberInSurah":40},{"number":79041,"text":"فَإِنَّ ٱلۡجَنَّةَ هِیَ ٱلۡمَأۡوَىٰ\n","numberInSurah":41},{"number":79042,"text":"یَسۡـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَیَّانَ مُرۡسَىٰهَا\n","numberInSurah":42},{"number":79043,"text":"فِیمَ أَنتَ مِن ذِكۡرَىٰهَاۤ\n","numberInSurah":43},{"number":79044,"text":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَاۤ\n","numberInSurah":44},{"number":79045,"text":"إِنَّمَاۤ أَنتَ مُنذِرُ مَن یَخۡشَىٰهَا\n","numberInSurah":45},{"number":79046,"text":"كَأَنَّهُمۡ یَوۡمَ یَرَوۡنَهَا لَمۡ یَلۡبَثُوۤا۟ إِلَّا عَشِیَّةً أَوۡ ضُحَىٰهَا\n","numberInSurah":46}]}}