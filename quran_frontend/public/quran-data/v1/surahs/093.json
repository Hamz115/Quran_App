{"data":{"number":93,"name":"سُورَةُ الضُّحَىٰ","englishName":"Ad-Dhuhaa","englishNameTranslation":"The Morning Hours","numberOfAyahs":11,"revelationType":"Meccan","ayahs":[{"number":93001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلضُّحَىٰ\n","numberInSurah":1},{"number":93002,"text":"وَٱلَّیۡلِ إِذَا سَجَىٰ\n","numberInSurah":2},{"number":93003,"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ\n","numberInSurah":3},{"number":93004,"text":"وَلَلۡـَٔاخِرَةُ خَیۡرࣱ لَّكَ مِنَ ٱلۡأُولَىٰ\n","numberInSurah":4},{"number":93005,"text":"وَلَسَوۡفَ یُعۡطِیكَ رَبُّكَ فَتَرۡضَىٰۤ\n","numberInSurah":5},{"number":93006,"text":"أَلَمۡ یَجِدۡكَ یَتِیمࣰا فَـَٔاوَىٰ\n","numberInSurah":6},{"number":93007,"text":"وَوَجَدَكَ ضَاۤلࣰّا فَهَدَىٰ\n","numberInSurah":7},{"number":93008,"text":"وَوَجَدَكَ عَاۤىِٕلࣰا فَأَغۡنَىٰ\n","numberInSurah":8},{"number":93009,"text":"فَأَمَّا ٱلۡیَتِیمَ فَلَا تَقۡهَرۡ\n","numberInSurah":9},{"number":93010,"text":"وَأَمَّا ٱلسَّاۤىِٕلَ فَلَا تَنۡهَرۡ\n","numberInSurah":10},{"number":93011,"text":"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ\n","numberInSurah":11}]}}