{"data":{"number":82,"name":"سُورَةُ الانفِطَارِ","englishName":"Al-Infitaar","englishNameTranslation":"The Cleaving","numberOfAyahs":19,"revelationType":"Meccan","ayahs":[{"number":82001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ إِذَا ٱلسَّمَاۤءُ ٱنفَطَرَتۡ\n","numberInSurah":1},{"number":82002,"text":"وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ\n","numberInSurah":2},{"number":82003,"text":"وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ\n","numberInSurah":3},{"number":82004,"text":"وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ\n","numberInSurah":4},{"number":82005,"text":"عَلِمَتۡ نَفۡسࣱ مَّا قَدَّمَتۡ وَأَخَّرَتۡ\n","numberInSurah":5},{"number":82006,"text":"یَـٰۤأَیُّهَا ٱلۡإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِیمِ\n","numberInSurah":6},{"number":82007,"text":"ٱلَّذِی خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ\n","numberInSurah":7},{"number":82008,"text":"فِیۤ أَیِّ صُورَةࣲ مَّا شَاۤءَ رَكَّبَكَ\n","numberInSurah":8},{"number":82009,"text":"كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّینِ\n","numberInSurah":9},{"number":82010,"text":"وَإِنَّ عَلَیۡكُمۡ لَحَـٰفِظِینَ\n","numberInSurah":10},{"number":82011,"text":"كِرَامࣰا كَـٰتِبِینَ\n","numberInSurah":11},{"number":82012,"text":"یَعۡلَمُونَ مَا تَفۡعَلُونَ\n","numberInSurah":12},{"number":82013,"text":"إِنَّ ٱلۡأَبۡرَارَ لَفِی نَعِیمࣲ\n","numberInSurah":13},{"number":82014,"text":"وَإِنَّ ٱلۡفُجَّارَ لَفِی جَحِیمࣲ\n","numberInSurah":14},{"number":82015,"text":"یَصۡلَوۡنَهَا یَوۡمَ ٱلدِّینِ\n","numberInSurah":15},{"number":82016,"text":"وَمَا هُمۡ عَنۡهَا بِغَاۤىِٕبِینَ\n","numberInSurah":16},{"number":82017,"text":"وَمَاۤ أَدۡرَىٰكَ مَا یَوۡمُ ٱلدِّینِ\n","numberInSurah":17},{"number":82018,"text":"ثُمَّ مَاۤ أَدۡرَىٰكَ مَا یَوۡمُ ٱلدِّینِ\n","numberInSurah":18},{"number":82019,"text":"یَوۡمَ لَا تَمۡلِكُ نَفۡسࣱ لِّنَفۡسࣲ شَیۡـࣰٔاۖ وَٱلۡأَمۡرُ یَوۡمَىِٕذࣲ لِّلَّهِ\n","numberInSurah":19}]}}