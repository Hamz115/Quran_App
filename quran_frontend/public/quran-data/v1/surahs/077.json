{"data":{"number":77,"name":"سُورَةُ المُرۡسَلَاتِ","englishName":"Al-Mursalaat","englishNameTranslation":"The Emissaries","numberOfAyahs":50,"revelationType":"Meccan","ayahs":[{"number":77001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلۡمُرۡسَلَـٰتِ عُرۡفࣰا\n","numberInSurah":1},{"number":77002,"text":"فَٱلۡعَـٰصِفَـٰتِ عَصۡفࣰا\n","numberInSurah":2},{"number":77003,"text":"وَٱلنَّـٰشِرَ ٰ⁠تِ نَشۡرࣰا\n","numberInSurah":3},{"number":77004,"text":"فَٱلۡفَـٰرِقَـٰتِ فَرۡقࣰا\n","numberInSurah":4},{"number":77005,"text":"فَٱلۡمُلۡقِیَـٰتِ ذِكۡرًا\n","numberInSurah":5},{"number":77006,"text":"عُذۡرًا أَوۡ نُذۡرًا\n","numberInSurah":6},{"number":77007,"text":"إِنَّمَا تُوعَدُونَ لَوَ ٰ⁠قِعࣱ\n","numberInSurah":7},{"number":77008,"text":"فَإِذَا ٱلنُّجُومُ طُمِسَتۡ\n","numberInSurah":8},{"number":77009,"text":"وَإِذَا ٱلسَّمَاۤءُ فُرِجَتۡ\n","numberInSurah":9},{"number":77010,"text":"وَإِذَا ٱلۡجِبَالُ نُسِفَتۡ\n","numberInSurah":10},{"number":77011,"text":"وَإِذَا ٱلرُّسُلُ أُقِّتَتۡ\n","numberInSurah":11},{"number":77012,"text":"لِأَیِّ یَوۡمٍ أُجِّلَتۡ\n","numberInSurah":12},{"number":77013,"text":"لِیَوۡمِ ٱلۡفَصۡلِ\n","numberInSurah":13},{"number":77014,"text":"وَمَاۤ أَدۡرَىٰكَ مَا یَوۡمُ ٱلۡفَصۡلِ\n","numberInSurah":14},{"number":77015,"text":"وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ\n","numberInSurah":15},{"number":77016,"text":"أَلَمۡ نُهۡلِكِ ٱلۡأَوَّلِینَ\n","numberInSurah":16},{"number":77017,"text":"ثُمَّ نُتۡبِعُهُمُ ٱلۡـَٔاخِرِینَ\n","numberInSurah":17},{"number":77018,"text":"كَذَ ٰ⁠لِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِینَ\n","numberInSurah":18},{"number":77019,"text":"وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ\n","numberInSurah":19},{"number":77020,"text":"أَلَمۡ نَخۡلُقكُّم مِّن مَّاۤءࣲ مَّهِینࣲ\n","numberInSurah":20},{"number":77021,"text":"فَجَعَلۡنَـٰهُ فِی قَرَارࣲ مَّكِینٍ\n","numberInSurah":21},{"number":77022,"text":"إِلَىٰ قَدَرࣲ مَّعۡلُومࣲ\n","numberInSurah":22},{"number":77023,"text":"فَقَدَرۡنَا فَنِعۡمَ ٱلۡقَـٰدِرُونَ\n","numberInSurah":23},{"number":77024,"text":"وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ\n","numberInSurah":24},{"number":77025,"text":"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ كِفَاتًا\n","numberInSurah":25},{"number":77026,"text":"أَحۡیَاۤءࣰ وَأَمۡوَ ٰ⁠تࣰا\n","numberInSurah":26},{"number":77027,"text":"وَجَعَلۡنَا فِیهَا رَوَ ٰ⁠سِیَ شَـٰمِخَـٰتࣲ وَأَسۡقَیۡنَـٰكُم مَّاۤءࣰ فُرَاتࣰا\n","numberInSurah":27},{"number":77028,"text":"وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ\n","numberInSurah":28},{"number":77029,"text":"ٱنطَلِقُوۤا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ\n","numberInSurah":29},{"number":77030,"text":"ٱنطَلِقُوۤا۟ إِلَىٰ ظِلࣲّ ذِی ثَلَـٰثِ شُعَبࣲ\n","numberInSurah":30},{"number":77031,"text":"لَّا ظَلِیلࣲ وَلَا یُغۡنِی مِنَ ٱللَّهَبِ\n","numberInSurah":31},{"number":77032,"text":"إِنَّهَا تَرۡمِی بِشَرَرࣲ كَٱلۡقَصۡرِ\n","numberInSurah":32},{"number":77033,"text":"كَأَنَّهُۥ جِمَـٰلَتࣱ صُفۡرࣱ\n","numberInSurah":33},{"number":77034,"text":"وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ\n","numberInSurah":34},{"number":77035,"text":"هَـٰذَا یَوۡمُ لَا یَنطِقُونَ\n","numberInSurah":35},{"number":77036,"text":"وَلَا یُؤۡذَنُ لَهُمۡ فَیَعۡتَذِرُونَ\n","numberInSurah":36},{"number":77037,"text":"وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ\n","numberInSurah":37},{"number":77038,"text":"هَـٰذَا یَوۡمُ ٱلۡفَصۡلِۖ جَمَعۡنَـٰكُمۡ وَٱلۡأَوَّلِینَ\n","numberInSurah":38},{"number":77039,"text":"فَإِن كَانَ لَكُمۡ كَیۡدࣱ فَكِیدُونِ\n","numberInSurah":39},{"number":77040,"text":"وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ\n","numberInSurah":40},{"number":77041,"text":"إِنَّ ٱلۡمُتَّقِینَ فِی ظِلَـٰلࣲ وَعُیُونࣲ\n","numberInSurah":41},{"number":77042,"text":"وَفَوَ ٰ⁠كِهَ مِمَّا یَشۡتَهُونَ\n","numberInSurah":42},{"number":77043,"text":"كُلُوا۟ وَٱشۡرَبُوا۟ هَنِیۤـَٔۢا بِمَا كُنتُمۡ تَعۡمَلُونَ\n","numberInSurah":43},{"number":77044,"text":"إِنَّا كَذَ ٰ⁠لِكَ نَجۡزِی ٱلۡمُحۡسِنِینَ\n","numberInSurah":44},{"number":77045,"text":"وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ\n","numberInSurah":45},{"number":77046,"text":"كُلُوا۟ وَتَمَتَّعُوا۟ قَلِیلًا إِنَّكُم مُّجۡرِمُونَ\n","numberInSurah":46},{"number":77047,"text":"وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ\n","numberInSurah":47},{"number":77048,"text":"وَإِذَا قِیلَ لَهُمُ ٱرۡكَعُوا۟ لَا یَرۡكَعُونَ\n","numberInSurah":48},{"number":77049,"text":"وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ\n","numberInSurah":49},{"number":77050,"text":"فَبِأَیِّ حَدِیثِۭ بَعۡدَهُۥ یُؤۡمِنُونَ\n","numberInSurah":50}]}}