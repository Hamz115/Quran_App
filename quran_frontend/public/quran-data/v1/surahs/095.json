{"data":{"number":95,"name":"سُورَةُ التِّينِ","englishName":"At-Tin","englishNameTranslation":"The Fig","numberOfAyahs":8,"revelationType":"Meccan","ayahs":[{"number":95001,"text":"بِّسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلتِّینِ وَٱلزَّیۡتُونِ\n","numberInSurah":1},{"number":95002,"text":"وَطُورِ سِینِینَ\n","numberInSurah":2},{"number":95003,"text":"وَهَـٰذَا ٱلۡبَلَدِ ٱلۡأَمِینِ\n","numberInSurah":3},{"number":95004,"text":"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَـٰنَ فِیۤ أَحۡسَنِ تَقۡوِیمࣲ\n","numberInSurah":4},{"number":95005,"text":"ثُمَّ رَدَدۡنَـٰهُ أَسۡفَلَ سَـٰفِلِینَ\n","numberInSurah":5},{"number":95006,"text":"إِلَّا ٱلَّذِینَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ فَلَهُمۡ أَجۡرٌ غَیۡرُ مَمۡنُونࣲ\n","numberInSurah":6},{"number":95007,"text":"فَمَا یُكَذِّبُكَ بَعۡدُ بِٱلدِّینِ\n","numberInSurah":7},{"number":95008,"text":"أَلَیۡسَ ٱللَّهُ بِأَحۡكَمِ ٱلۡحَـٰكِمِینَ\n","numberInSurah":8}]}}