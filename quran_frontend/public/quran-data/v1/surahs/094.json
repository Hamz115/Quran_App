{"data":{"number":94,"name":"سُورَةُ الشَّرۡحِ","englishName":"Ash-Sharh","englishNameTranslation":"The Consolation","numberOfAyahs":8,"revelationType":"Meccan","ayahs":[{"number":94001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ\n","numberInSurah":1},{"number":94002,"text":"وَوَضَعۡنَا عَنكَ وِزۡرَكَ\n","numberInSurah":2},{"number":94003,"text":"ٱلَّذِیۤ أَنقَضَ ظَهۡرَكَ\n","numberInSurah":3},{"number":94004,"text":"وَرَفَعۡنَا لَكَ ذِكۡرَكَ\n","numberInSurah":4},{"number":94005,"text":"فَإِنَّ مَعَ ٱلۡعُسۡرِ یُسۡرًا\n","numberInSurah":5},{"number":94006,"text":"إِنَّ مَعَ ٱلۡعُسۡرِ یُسۡرࣰا\n","numberInSurah":6},{"number":94007,"text":"فَإِذَا فَرَغۡتَ فَٱنصَبۡ\n","numberInSurah":7},{"number":94008,"text":"وَإِلَىٰ رَبِّكَ فَٱرۡغَب\n","numberInSurah":8}]}}