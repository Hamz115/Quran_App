{"data":{"number":78,"name":"سُورَةُ النَّبَإِ","englishName":"An-Naba","englishNameTranslation":"The Announcement","numberOfAyahs":40,"revelationType":"Meccan","ayahs":[{"number":78001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ عَمَّ یَتَسَاۤءَلُونَ\n","numberInSurah":1},{"number":78002,"text":"عَنِ ٱلنَّبَإِ ٱلۡعَظِیمِ\n","numberInSurah":2},{"number":78003,"text":"ٱلَّذِی هُمۡ فِیهِ مُخۡتَلِفُونَ\n","numberInSurah":3},{"number":78004,"text":"كَلَّا سَیَعۡلَمُونَ\n","numberInSurah":4},{"number":78005,"text":"ثُمَّ كَلَّا سَیَعۡلَمُونَ\n","numberInSurah":5},{"number":78006,"text":"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ مِهَـٰدࣰا\n","numberInSurah":6},{"number":78007,"text":"وَٱلۡجِبَالَ أَوۡتَادࣰا\n","numberInSurah":7},{"number":78008,"text":"وَخَلَقۡنَـٰكُمۡ أَزۡوَ ٰ⁠جࣰا\n","numberInSurah":8},{"number":78009,"text":"وَجَعَلۡنَا نَوۡمَكُمۡ سُبَاتࣰا\n","numberInSurah":9},{"number":78010,"text":"وَجَعَلۡنَا ٱلَّیۡلَ لِبَاسࣰا\n","numberInSurah":10},{"number":78011,"text":"وَجَعَلۡنَا ٱلنَّهَارَ مَعَاشࣰا\n","numberInSurah":11},{"number":78012,"text":"وَبَنَیۡنَا فَوۡقَكُمۡ سَبۡعࣰا شِدَادࣰا\n","numberInSurah":12},{"number":78013,"text":"وَجَعَلۡنَا سِرَاجࣰا وَهَّاجࣰا\n","numberInSurah":13},{"number":78014,"text":"وَأَنزَلۡنَا مِنَ ٱلۡمُعۡصِرَ ٰ⁠تِ مَاۤءࣰ ثَجَّاجࣰا\n","numberInSurah":14},{"number":78015,"text":"لِّنُخۡرِجَ بِهِۦ حَبࣰّا وَنَبَاتࣰا\n","numberInSurah":15},{"number":78016,"text":"وَجَنَّـٰتٍ أَلۡفَافًا\n","numberInSurah":16},{"number":78017,"text":"إِنَّ یَوۡمَ ٱلۡفَصۡلِ كَانَ مِیقَـٰتࣰا\n","numberInSurah":17},{"number":78018,"text":"یَوۡمَ یُنفَخُ فِی ٱلصُّورِ فَتَأۡتُونَ أَفۡوَاجࣰا\n","numberInSurah":18},{"number":78019,"text":"وَفُتِحَتِ ٱلسَّمَاۤءُ فَكَانَتۡ أَبۡوَ ٰ⁠بࣰا\n","numberInSurah":19},{"number":78020,"text":"وَسُیِّرَتِ ٱلۡجِبَالُ فَكَانَتۡ سَرَابًا\n","numberInSurah":20},{"number":78021,"text":"إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادࣰا\n","numberInSurah":21},{"number":78022,"text":"لِّلطَّـٰغِینَ مَـَٔابࣰا\n","numberInSurah":22},{"number":78023,"text":"لَّـٰبِثِینَ فِیهَاۤ أَحۡقَابࣰا\n","numberInSurah":23},{"number":78024,"text":"لَّا یَذُوقُونَ فِیهَا بَرۡدࣰا وَلَا شَرَابًا\n","numberInSurah":24},{"number":78025,"text":"إِلَّا حَمِیمࣰا وَغَسَّاقࣰا\n","numberInSurah":25},{"number":78026,"text":"جَزَاۤءࣰ وِفَاقًا\n","numberInSurah":26},{"number":78027,"text":"إِنَّهُمۡ كَانُوا۟ لَا یَرۡجُونَ حِسَابࣰا\n","numberInSurah":27},{"number":78028,"text":"وَكَذَّبُوا۟ بِـَٔایَـٰتِنَا كِذَّابࣰا\n","numberInSurah":28},{"number":78029,"text":"وَكُلَّ شَیۡءٍ أَحۡصَیۡنَـٰهُ كِتَـٰبࣰا\n","numberInSurah":29},{"number":78030,"text":"فَذُوقُوا۟ فَلَن نَّزِیدَكُمۡ إِلَّا عَذَابًا\n","numberInSurah":30},{"number":78031,"text":"إِنَّ لِلۡمُتَّقِینَ مَفَازًا\n","numberInSurah":31},{"number":78032,"text":"حَدَاۤىِٕقَ وَأَعۡنَـٰبࣰا\n","numberInSurah":32},{"number":78033,"text":"وَكَوَاعِبَ أَتۡرَابࣰا\n","numberInSurah":33},{"number":78034,"text":"وَكَأۡسࣰا دِهَاقࣰا\n","numberInSurah":34},{"number":78035,"text":"لَّا یَسۡمَعُونَ فِیهَا لَغۡوࣰا وَلَا كِذَّ ٰ⁠بࣰا\n","numberInSurah":35},{"number":78036,"text":"جَزَاۤءࣰ مِّن رَّبِّكَ عَطَاۤءً حِسَابࣰا\n","numberInSurah":36},{"number":78037,"text":"رَّبِّ ٱلسَّمَـٰوَ ٰ⁠تِ وَٱلۡأَرۡضِ وَمَا بَیۡنَهُمَا ٱلرَّحۡمَـٰنِۖ لَا یَمۡلِكُونَ مِنۡهُ خِطَابࣰا\n","numberInSurah":37},{"number":78038,"text":"یَوۡمَ یَقُومُ ٱلرُّوحُ وَٱلۡمَلَـٰۤىِٕكَةُ صَفࣰّاۖ لَّا یَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَـٰنُ وَقَالَ صَوَابࣰا\n","numberInSurah":38},{"number":78039,"text":"ذَ ٰ⁠لِكَ ٱلۡیَوۡمُ ٱلۡحَقُّۖ فَمَن شَاۤءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا\n","numberInSurah":39},{"number":78040,"text":"إِنَّاۤ أَنذَرۡنَـٰكُمۡ عَذَابࣰا قَرِیبࣰا یَوۡمَ یَنظُرُ ٱلۡمَرۡءُ مَا قَدَّمَتۡ یَدَاهُ وَیَقُولُ ٱلۡكَافِرُ یَـٰلَیۡتَنِی كُنتُ تُرَ ٰ⁠بَۢا\n","numberInSurah":40}]}}