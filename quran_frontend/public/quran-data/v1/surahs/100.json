{"data":{"number":100,"name":"سُورَةُ العَادِيَاتِ","englishName":"Al-Aadiyaat","englishNameTranslation":"The Chargers","numberOfAyahs":11,"revelationType":"Meccan","ayahs":[{"number":100001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلۡعَـٰدِیَـٰتِ ضَبۡحࣰا\n","numberInSurah":1},{"number":100002,"text":"فَٱلۡمُورِیَـٰتِ قَدۡحࣰا\n","numberInSurah":2},{"number":100003,"text":"فَٱلۡمُغِیرَ ٰ⁠تِ صُبۡحࣰا\n","numberInSurah":3},{"number":100004,"text":"فَأَثَرۡنَ بِهِۦ نَقۡعࣰا\n","numberInSurah":4},{"number":100005,"text":"فَوَسَطۡنَ بِهِۦ جَمۡعًا\n","numberInSurah":5},{"number":100006,"text":"إِنَّ ٱلۡإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودࣱ\n","numberInSurah":6},{"number":100007,"text":"وَإِنَّهُۥ عَلَىٰ ذَ ٰ⁠لِكَ لَشَهِیدࣱ\n","numberInSurah":7},{"number":100008,"text":"وَإِنَّهُۥ لِحُبِّ ٱلۡخَیۡرِ لَشَدِیدٌ\n","numberInSurah":8},{"number":100009,"text":"۞ أَفَلَا یَعۡلَمُ إِذَا بُعۡثِرَ مَا فِی ٱلۡقُبُورِ\n","numberInSurah":9},{"number":100010,"text":"وَحُصِّلَ مَا فِی ٱلصُّدُورِ\n","numberInSurah":10},{"number":100011,"text":"إِنَّ رَبَّهُم بِهِمۡ یَوۡمَىِٕذࣲ لَّخَبِیرُۢ\n","numberInSurah":11}]}}