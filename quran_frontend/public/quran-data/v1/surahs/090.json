{"data":{"number":90,"name":"سُورَةُ البَلَدِ","englishName":"Al-Balad","englishNameTranslation":"The City","numberOfAyahs":20,"revelationType":"Meccan","ayahs":[{"number":90001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ لَاۤ أُقۡسِمُ بِهَـٰذَا ٱلۡبَلَدِ\n","numberInSurah":1},{"number":90002,"text":"وَأَنتَ حِلُّۢ بِهَـٰذَا ٱلۡبَلَدِ\n","numberInSurah":2},{"number":90003,"text":"وَوَالِدࣲ وَمَا وَلَدَ\n","numberInSurah":3},{"number":90004,"text":"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَـٰنَ فِی كَبَدٍ\n","numberInSurah":4},{"number":90005,"text":"أَیَحۡسَبُ أَن لَّن یَقۡدِرَ عَلَیۡهِ أَحَدࣱ\n","numberInSurah":5},{"number":90006,"text":"یَقُولُ أَهۡلَكۡتُ مَالࣰا لُّبَدًا\n","numberInSurah":6},{"number":90007,"text":"أَیَحۡسَبُ أَن لَّمۡ یَرَهُۥۤ أَحَدٌ\n","numberInSurah":7},{"number":90008,"text":"أَلَمۡ نَجۡعَل لَّهُۥ عَیۡنَیۡنِ\n","numberInSurah":8},{"number":90009,"text":"وَلِسَانࣰا وَشَفَتَیۡنِ\n","numberInSurah":9},{"number":90010,"text":"وَهَدَیۡنَـٰهُ ٱلنَّجۡدَیۡنِ\n","numberInSurah":10},{"number":90011,"text":"فَلَا ٱقۡتَحَمَ ٱلۡعَقَبَةَ\n","numberInSurah":11},{"number":90012,"text":"وَمَاۤ أَدۡرَىٰكَ مَا ٱلۡعَقَبَةُ\n","numberInSurah":12},{"number":90013,"text":"فَكُّ رَقَبَةٍ\n","numberInSurah":13},{"number":90014,"text":"أَوۡ إِطۡعَـٰمࣱ فِی یَوۡمࣲ ذِی مَسۡغَبَةࣲ\n","numberInSurah":14},{"number":90015,"text":"یَتِیمࣰا ذَا مَقۡرَبَةٍ\n","numberInSurah":15},{"number":90016,"text":"أَوۡ مِسۡكِینࣰا ذَا مَتۡرَبَةࣲ\n","numberInSurah":16},{"number":90017,"text":"ثُمَّ كَانَ مِنَ ٱلَّذِینَ ءَامَنُوا۟ وَتَوَاصَوۡا۟ بِٱلصَّبۡرِ وَتَوَاصَوۡا۟ بِٱلۡمَرۡحَمَةِ\n","numberInSurah":17},{"number":90018,"text":"أُو۟لَـٰۤىِٕكَ أَصۡحَـٰبُ ٱلۡمَیۡمَنَةِ\n","numberInSurah":18},{"number":90019,"text":"وَٱلَّذِینَ كَفَرُوا۟ بِـَٔایَـٰتِنَا هُمۡ أَصۡحَـٰبُ ٱلۡمَشۡـَٔمَةِ\n","numberInSurah":19},{"number":90020,"text":"عَلَیۡهِمۡ نَارࣱ مُّؤۡصَدَةُۢ\n","numberInSurah":20}]}}