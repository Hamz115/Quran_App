{"data":{"number":37,"name":"سُورَةُ الصَّافَّاتِ","englishName":"As-Saaffaat","englishNameTranslation":"Those drawn up in Ranks","numberOfAyahs":182,"revelationType":"Meccan","ayahs":[{"number":37001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلصَّـٰۤفَّـٰتِ صَفࣰّا\n","numberInSurah":1},{"number":37002,"text":"فَٱلزَّ ٰ⁠جِرَ ٰ⁠تِ زَجۡرࣰا\n","numberInSurah":2},{"number":37003,"text":"فَٱلتَّـٰلِیَـٰتِ ذِكۡرًا\n","numberInSurah":3},{"number":37004,"text":"إِنَّ إِلَـٰهَكُمۡ لَوَ ٰ⁠حِدࣱ\n","numberInSurah":4},{"number":37005,"text":"رَّبُّ ٱلسَّمَـٰوَ ٰ⁠تِ وَٱلۡأَرۡضِ وَمَا بَیۡنَهُمَا وَرَبُّ ٱلۡمَشَـٰرِقِ\n","numberInSurah":5},{"number":37006,"text":"إِنَّا زَیَّنَّا ٱلسَّمَاۤءَ ٱلدُّنۡیَا بِزِینَةٍ ٱلۡكَوَاكِبِ\n","numberInSurah":6},{"number":37007,"text":"وَحِفۡظࣰا مِّن كُلِّ شَیۡطَـٰنࣲ مَّارِدࣲ\n","numberInSurah":7},{"number":37008,"text":"لَّا یَسَّمَّعُونَ إِلَى ٱلۡمَلَإِ ٱلۡأَعۡلَىٰ وَیُقۡذَفُونَ مِن كُلِّ جَانِبࣲ\n","numberInSurah":8},{"number":37009,"text":"دُحُورࣰاۖ وَلَهُمۡ عَذَابࣱ وَاصِبٌ\n","numberInSurah":9},{"number":37010,"text":"إِلَّا مَنۡ خَطِفَ ٱلۡخَطۡفَةَ فَأَتۡبَعَهُۥ شِهَابࣱ ثَاقِبࣱ\n","numberInSurah":10},{"number":37011,"text":"فَٱسۡتَفۡتِهِمۡ أَهُمۡ أَشَدُّ خَلۡقًا أَم مَّنۡ خَلَقۡنَاۤۚ إِنَّا خَلَقۡنَـٰهُم مِّن طِینࣲ لَّازِبِۭ\n","numberInSurah":11},{"number":37012,"text":"بَلۡ عَجِبۡتَ وَیَسۡخَرُونَ\n","numberInSurah":12},{"number":37013,"text":"وَإِذَا ذُكِّرُوا۟ لَا یَذۡكُرُونَ\n","numberInSurah":13},{"number":37014,"text":"وَإِذَا رَأَوۡا۟ ءَایَةࣰ یَسۡتَسۡخِرُونَ\n","numberInSurah":14},{"number":37015,"text":"وَقَالُوۤا۟ إِنۡ هَـٰذَاۤ إِلَّا سِحۡرࣱ مُّبِینٌ\n","numberInSurah":15},{"number":37016,"text":"أَءِذَا مِتۡنَا وَكُنَّا تُرَابࣰا وَعِظَـٰمًا أَءِنَّا لَمَبۡعُوثُونَ\n","numberInSurah":16},{"number":37017,"text":"أَوَءَابَاۤؤُنَا ٱلۡأَوَّلُونَ\n","numberInSurah":17},{"number":37018,"text":"قُلۡ نَعَمۡ وَأَنتُمۡ دَ ٰ⁠خِرُونَ\n","numberInSurah":18},{"number":37019,"text":"فَإِنَّمَا هِیَ زَجۡرَةࣱ وَ ٰ⁠حِدَةࣱ فَإِذَا هُمۡ یَنظُرُ