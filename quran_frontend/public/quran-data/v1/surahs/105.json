{"data":{"number":105,"name":"سُورَةُ الفِيلِ","englishName":"Al-Fil","englishNameTranslation":"The Elephant","numberOfAyahs":5,"revelationType":"Meccan","ayahs":[{"number":105001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ أَلَمۡ تَرَ كَیۡفَ فَعَلَ رَبُّكَ بِأَصۡحَـٰبِ ٱلۡفِیلِ\n","numberInSurah":1},{"number":105002,"text":"أَلَمۡ یَجۡعَلۡ كَیۡدَهُمۡ فِی تَضۡلِیلࣲ\n","numberInSurah":2},{"number":105003,"text":"وَأَرۡسَلَ عَلَیۡهِمۡ طَیۡرًا أَبَابِیلَ\n","numberInSurah":3},{"number":105004,"text":"تَرۡمِیهِم بِحِجَارَةࣲ مِّن سِجِّیلࣲ\n","numberInSurah":4},{"number":105005,"text":"فَجَعَلَهُمۡ كَعَصۡفࣲ مَّأۡكُولِۭ\n","numberInSurah":5}]}}