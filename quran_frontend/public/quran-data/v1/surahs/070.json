{"data":{"number":70,"name":"سُورَةُ المَعَارِجِ","englishName":"Al-Ma'aarij","englishNameTranslation":"The Ascending Stairways","numberOfAyahs":44,"revelationType":"Meccan","ayahs":[{"number":70001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ سَأَلَ سَاۤىِٕلُۢ بِعَذَابࣲ وَاقِعࣲ\n","numberInSurah":1},{"number":70002,"text":"لِّلۡكَـٰفِرِینَ لَیۡسَ لَهُۥ دَافِعࣱ\n","numberInSurah":2},{"number":70003,"text":"مِّنَ ٱللَّهِ ذِی ٱلۡمَعَارِجِ\n","numberInSurah":3},{"number":70004,"text":"تَعۡرُجُ ٱلۡمَلَـٰۤىِٕكَةُ وَٱلرُّوحُ إِلَیۡهِ فِی یَوۡمࣲ كَانَ مِقۡدَارُهُۥ خَمۡسِینَ أَلۡفَ سَنَةࣲ\n","numberInSurah":4},{"number":70005,"text":"فَٱصۡبِرۡ صَبۡرࣰا جَمِیلًا\n","numberInSurah":5},{"number":70006,"text":"إِنَّهُمۡ یَرَوۡنَهُۥ بَعِیدࣰا\n","numberInSurah":6},{"number":70007,"text":"وَنَرَىٰهُ قَرِیبࣰا\n","numberInSurah":7},{"number":70008,"text":"یَوۡمَ تَكُونُ ٱلسَّمَاۤءُ كَٱلۡمُهۡلِ\n","numberInSurah":8},{"number":70009,"text":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ\n","numberInSurah":9},{"number":70010,"text":"وَلَا یَسۡـَٔلُ حَمِیمٌ حَمِیمࣰا\n","numberInSurah":10},{"number":70011,"text":"یُبَصَّرُونَهُمۡۚ یَوَدُّ ٱلۡمُجۡرِمُ لَوۡ یَفۡتَدِی مِنۡ عَذَابِ یَوۡمِىِٕذِۭ بِبَنِیهِ\n","numberInSurah":11},{"number":70012,"text":"وَصَـٰحِبَتِهِۦ وَأَخِیهِ\n","numberInSurah":12},{"number":70013,"text":"وَفَصِیلَتِهِ ٱلَّتِی تُـٔۡوِیهِ\n","numberInSurah":13},{"number":70014,"text":"وَمَن فِی ٱلۡأَرۡضِ جَمِیعࣰا ثُمَّ یُنجِیهِ\n","numberInSurah":14},{"number":70015,"text":"كَلَّاۤۖ إِنَّهَا لَظَىٰ\n","numberInSurah":15},{"number":70016,"text":"نَزَّاعَةࣰ لِّلشَّوَىٰ\n","numberInSurah":16},{"number":70017,"text":"تَدۡعُوا۟ مَنۡ أَدۡبَرَ وَتَوَلَّىٰ\n","numberInSurah":17},{"number":70018,"text":"وَجَمَعَ فَأَوۡعَىٰۤ\n","numberInSurah":18},{"number":70019,"text":"۞ إِنَّ ٱلۡإِنسَـٰنَ خُلِقَ هَلُوعًا\n","numberInSurah":19},{"number":70020,"text":"إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعࣰا\n","numberInSurah":20},{"number":70021,"text":"وَإِذَا مَسَّهُ ٱلۡخَیۡرُ مَنُوعًا\n","numberInSurah":21},{"number":70022,"text":"إِلَّا ٱلۡمُصَلِّینَ\n","numberInSurah":22},{"number":70023,"text":"ٱلَّذِینَ هُمۡ عَلَىٰ صَلَاتِهِمۡ دَاۤىِٕمُونَ\n","numberInSurah":23},{"number":70024,"text":"وَٱلَّذِینَ فِیۤ أَمۡوَ ٰ⁠لِهِمۡ حَقࣱّ مَّعۡلُومࣱ\n","numberInSurah":24},{"number":70025,"text":"لِّلسَّاۤىِٕلِ وَٱلۡمَحۡرُومِ\n","numberInSurah":25},{"number":70026,"text":"وَٱلَّذِینَ یُصَدِّقُونَ بِیَوۡمِ ٱلدِّینِ\n","numberInSurah":26},{"number":70027,"text":"وَٱلَّذِینَ هُم مِّنۡ عَذَابِ رَبِّهِم مُّشۡفِقُونَ\n","numberInSurah":27},{"number":70028,"text":"إِنَّ عَذَابَ رَبِّهِمۡ غَیۡرُ مَأۡمُونࣲ\n","numberInSurah":28},{"number":70029,"text":"وَٱلَّذِینَ هُمۡ لِفُرُوجِهِمۡ حَـٰفِظُونَ\n","numberInSurah":29},{"number":70030,"text":"إِلَّا عَلَىٰۤ أَزۡوَ ٰ⁠جِهِمۡ أَوۡ مَا مَلَكَتۡ أَیۡمَـٰنُهُمۡ فَإِنَّهُمۡ غَیۡرُ مَلُومِینَ\n","numberInSurah":30},{"number":70031,"text":"فَمَنِ ٱبۡتَغَىٰ وَرَاۤءَ ذَ ٰ⁠لِكَ فَأُو۟لَـٰۤىِٕكَ هُمُ ٱلۡعَادُونَ\n","numberInSurah":31},{"number":70032,"text":"وَٱلَّذِینَ هُمۡ لِأَمَـٰنَـٰتِهِمۡ وَعَهۡدِهِمۡ رَ ٰ⁠عُونَ\n","numberInSurah":32},{"number":70033,"text":"وَٱلَّذِینَ هُم بِشَهَـٰدَ ٰ⁠تِهِمۡ قَاۤىِٕمُونَ\n","numberInSurah":33},{"number":70034,"text":"وَٱلَّذِینَ هُمۡ عَلَىٰ صَلَاتِهِمۡ یُحَافِظُونَ\n","numberInSurah":34},{"number":70035,"text":"أُو۟لَـٰۤىِٕكَ فِی جَنَّـٰتࣲ مُّكۡرَمُونَ\n","numberInSurah":35},{"number":70036,"text":"فَمَالِ ٱلَّذِینَ كَفَرُوا۟ قِبَلَكَ مُهۡطِعِینَ\n","numberInSurah":36},{"number":70037,"text":"عَنِ ٱلۡیَمِینِ وَعَنِ ٱلشِّمَالِ عِزِینَ\n","numberInSurah":37},{"number":70038,"text":"أَیَطۡمَعُ كُلُّ ٱمۡرِئࣲ مِّنۡهُمۡ أَن یُدۡخَلَ جَنَّةَ نَعِیمࣲ\n","numberInSurah":38},{"number":70039,"text":"كَلَّاۤۖ إِنَّا خَلَقۡنَـٰهُم مِّمَّا یَعۡلَمُونَ\n","numberInSurah":39},{"number":70040,"text":"فَلَاۤ أُقۡسِمُ بِرَبِّ ٱلۡمَشَـٰرِقِ وَٱلۡمَغَـٰرِبِ إِنَّا لَقَـٰدِرُونَ\n","numberInSurah":40},{"number":70041,"text":"عَلَىٰۤ أَن نُّبَدِّلَ خَیۡرࣰا مِّنۡهُمۡ وَمَا نَحۡنُ بِمَسۡبُوقِینَ\n","numberInSurah":41},{"number":70042,"text":"فَذَرۡهُمۡ یَخُوضُوا۟ وَیَلۡعَبُوا۟ حَتَّىٰ یُلَـٰقُوا۟ یَوۡمَهُمُ ٱلَّذِی یُوعَدُونَ\n","numberInSurah":42},{"number":70043,"text":"یَوۡمَ یَخۡرُجُونَ مِنَ ٱلۡأَجۡدَاثِ سِرَاعࣰا كَأَنَّهُمۡ إِلَىٰ نُصُبࣲ یُوفِضُونَ\n","numberInSurah":43},{"number":70044,"text":"خَـٰشِعَةً أَبۡصَـٰرُهُمۡ تَرۡهَقُهُمۡ ذِلَّةࣱۚ ذَ ٰ⁠لِكَ ٱلۡیَوۡمُ ٱلَّذِی كَانُوا۟ یُوعَدُونَ\n","numberInSurah":44}]}}