{"data":{"number":85,"name":"سُورَةُ البُرُوجِ","englishName":"Al-Burooj","englishNameTranslation":"The Constellations","numberOfAyahs":22,"revelationType":"Meccan","ayahs":[{"number":85001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلسَّمَاۤءِ ذَاتِ ٱلۡبُرُوجِ\n","numberInSurah":1},{"number":85002,"text":"وَٱلۡیَوۡمِ ٱلۡمَوۡعُودِ\n","numberInSurah":2},{"number":85003,"text":"وَشَاهِدࣲ وَمَشۡهُودࣲ\n","numberInSurah":3},{"number":85004,"text":"قُتِلَ أَصۡحَـٰبُ ٱلۡأُخۡدُودِ\n","numberInSurah":4},{"number":85005,"text":"ٱلنَّارِ ذَاتِ ٱلۡوَقُودِ\n","numberInSurah":5},{"number":85006,"text":"إِذۡ هُمۡ عَلَیۡهَا قُعُودࣱ\n","numberInSurah":6},{"number":85007,"text":"وَهُمۡ عَلَىٰ مَا یَفۡعَلُونَ بِٱلۡمُؤۡمِنِینَ شُهُودࣱ\n","numberInSurah":7},{"number":85008,"text":"وَمَا نَقَمُوا۟ مِنۡهُمۡ إِلَّاۤ أَن یُؤۡمِنُوا۟ بِٱللَّهِ ٱلۡعَزِیزِ ٱلۡحَمِیدِ\n","numberInSurah":8},{"number":85009,"text":"ٱلَّذِی لَهُۥ مُلۡكُ ٱلسَّمَـٰوَ ٰ⁠تِ وَٱلۡأَرۡضِۚ وَٱللَّهُ عَلَىٰ كُلِّ شَیۡءࣲ شَهِیدٌ\n","numberInSurah":9},{"number":85010,"text":"إِنَّ ٱلَّذِینَ فَتَنُوا۟ ٱلۡمُؤۡمِنِینَ وَٱلۡمُؤۡمِنَـٰتِ ثُمَّ لَمۡ یَتُوبُوا۟ فَلَهُمۡ عَذَابُ جَهَنَّمَ وَلَهُمۡ عَذَابُ ٱلۡحَرِیقِ\n","numberInSurah":10},{"number":85011,"text":"إِنَّ ٱلَّذِینَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمۡ جَنَّـٰتࣱ تَجۡرِی مِن تَحۡتِهَا ٱلۡأَنۡهَـٰرُۚ ذَ ٰ⁠لِكَ ٱلۡفَوۡزُ ٱلۡكَبِیرُ\n","numberInSurah":11},{"number":85012,"text":"إِنَّ بَطۡشَ رَبِّكَ لَشَدِیدٌ\n","numberInSurah":12},{"number":85013,"text":"إِنَّهُۥ هُوَ یُبۡدِئُ وَیُعِیدُ\n","numberInSurah":13},{"number":85014,"text":"وَهُوَ ٱلۡغَفُورُ ٱلۡوَدُودُ\n","numberInSurah":14},{"number":85015,"text":"ذُو ٱلۡعَرۡشِ ٱلۡمَجِیدُ\n","numberInSurah":15},{"number":85016,"text":"فَعَّالࣱ لِّمَا یُرِیدُ\n","numberInSurah":16},{"number":85017,"text":"هَلۡ أَتَىٰكَ حَدِیثُ ٱلۡجُنُودِ\n","numberInSurah":17},{"number":85018,"text":"فِرۡعَوۡنَ وَثَمُودَ\n","numberInSurah":18},{"number":85019,"text":"بَلِ ٱلَّذِینَ كَفَرُوا۟ فِی تَكۡذِیبࣲ\n","numberInSurah":19},{"number":85020,"text":"وَٱللَّهُ مِن وَرَاۤىِٕهِم مُّحِیطُۢ\n","numberInSurah":20},{"number":85021,"text":"بَلۡ هُوَ قُرۡءَانࣱ مَّجِیدࣱ\n","numberInSurah":21},{"number":85022,"text":"فِی لَوۡحࣲ مَّحۡفُوظِۭ\n","numberInSurah":22}]}}