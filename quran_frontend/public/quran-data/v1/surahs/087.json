{"data":{"number":87,"name":"سُورَةُ الأَعۡلَىٰ","englishName":"Al-A'laa","englishNameTranslation":"The Most High","numberOfAyahs":19,"revelationType":"Meccan","ayahs":[{"number":87001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى\n","numberInSurah":1},{"number":87002,"text":"ٱلَّذِی خَلَقَ فَسَوَّىٰ\n","numberInSurah":2},{"number":87003,"text":"وَٱلَّذِی قَدَّرَ فَهَدَىٰ\n","numberInSurah":3},{"number":87004,"text":"وَٱلَّذِیۤ أَخۡرَجَ ٱلۡمَرۡعَىٰ\n","numberInSurah":4},{"number":87005,"text":"فَجَعَلَهُۥ غُثَاۤءً أَحۡوَىٰ\n","numberInSurah":5},{"number":87006,"text":"سَنُقۡرِئُكَ فَلَا تَنسَىٰۤ\n","numberInSurah":6},{"number":87007,"text":"إِلَّا مَا شَاۤءَ ٱللَّهُۚ إِنَّهُۥ یَعۡلَمُ ٱلۡجَهۡرَ وَمَا یَخۡفَىٰ\n","numberInSurah":7},{"number":87008,"text":"وَنُیَسِّرُكَ لِلۡیُسۡرَىٰ\n","numberInSurah":8},{"number":87009,"text":"فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ\n","numberInSurah":9},{"number":87010,"text":"سَیَذَّكَّرُ مَن یَخۡشَىٰ\n","numberInSurah":10},{"number":87011,"text":"وَیَتَجَنَّبُهَا ٱلۡأَشۡقَى\n","numberInSurah":11},{"number":87012,"text":"ٱلَّذِی یَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ\n","numberInSurah":12},{"number":87013,"text":"ثُمَّ لَا یَمُوتُ فِیهَا وَلَا یَحۡیَىٰ\n","numberInSurah":13},{"number":87014,"text":"قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ\n","numberInSurah":14},{"number":87015,"text":"وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ\n","numberInSurah":15},{"number":87016,"text":"بَلۡ تُؤۡثِرُونَ ٱلۡحَیَوٰةَ ٱلدُّنۡیَا\n","numberInSurah":16},{"number":87017,"text":"وَٱلۡـَٔاخِرَةُ خَیۡرࣱ وَأَبۡقَىٰۤ\n","numberInSurah":17},{"number":87018,"text":"إِنَّ هَـٰذَا لَفِی ٱلصُّحُفِ ٱلۡأُولَىٰ\n","numberInSurah":18},{"number":87019,"text":"صُحُفِ إِبۡرَ ٰ⁠هِیمَ وَمُوسَىٰ\n","numberInSurah":19}]}}