{"data":{"number":86,"name":"سُورَةُ الطَّارِقِ","englishName":"At-Taariq","englishNameTranslation":"The Morning Star","numberOfAyahs":17,"revelationType":"Meccan","ayahs":[{"number":86001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلسَّمَاۤءِ وَٱلطَّارِقِ\n","numberInSurah":1},{"number":86002,"text":"وَمَاۤ أَدۡرَىٰكَ مَا ٱلطَّارِقُ\n","numberInSurah":2},{"number":86003,"text":"ٱلنَّجۡمُ ٱلثَّاقِبُ\n","numberInSurah":3},{"number":86004,"text":"إِن كُلُّ نَفۡسࣲ لَّمَّا عَلَیۡهَا حَافِظࣱ\n","numberInSurah":4},{"number":86005,"text":"فَلۡیَنظُرِ ٱلۡإِنسَـٰنُ مِمَّ خُلِقَ\n","numberInSurah":5},{"number":86006,"text":"خُلِقَ مِن مَّاۤءࣲ دَافِقࣲ\n","numberInSurah":6},{"number":86007,"text":"یَخۡرُجُ مِنۢ بَیۡنِ ٱلصُّلۡبِ وَٱلتَّرَاۤىِٕبِ\n","numberInSurah":7},{"number":86008,"text":"إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرࣱ\n","numberInSurah":8},{"number":86009,"text":"یَوۡمَ تُبۡلَى ٱلسَّرَاۤىِٕرُ\n","numberInSurah":9},{"number":86010,"text":"فَمَا لَهُۥ مِن قُوَّةࣲ وَلَا نَاصِرࣲ\n","numberInSurah":10},{"number":86011,"text":"وَٱلسَّمَاۤءِ ذَاتِ ٱلرَّجۡعِ\n","numberInSurah":11},{"number":86012,"text":"وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ\n","numberInSurah":12},{"number":86013,"text":"إِنَّهُۥ لَقَوۡلࣱ فَصۡلࣱ\n","numberInSurah":13},{"number":86014,"text":"وَمَا هُوَ بِٱلۡهَزۡلِ\n","numberInSurah":14},{"number":86015,"text":"إِنَّهُمۡ یَكِیدُونَ كَیۡدࣰا\n","numberInSurah":15},{"number":86016,"text":"وَأَكِیدُ كَیۡدࣰا\n","numberInSurah":16},{"number":86017,"text":"فَمَهِّلِ ٱلۡكَـٰفِرِینَ أَمۡهِلۡهُمۡ رُوَیۡدَۢا\n","numberInSurah":17}]}}