{"data":{"number":53,"name":"سُورَةُ النَّجۡمِ","englishName":"An-Najm","englishNameTranslation":"The Star","numberOfAyahs":62,"revelationType":"Meccan","ayahs":[{"number":53001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلنَّجۡمِ إِذَا هَوَىٰ\n","numberInSurah":1},{"number":53002,"text":"مَا ضَلَّ صَاحِبُكُمۡ وَمَا غَوَىٰ\n","numberInSurah":2},{"number":53003,"text":"وَمَا یَنطِقُ عَنِ ٱلۡهَوَىٰۤ\n","numberInSurah":3},{"number":53004,"text":"إِنۡ هُوَ إِلَّا وَحۡیࣱ یُوحَىٰ\n","numberInSurah":4},{"number":53005,"text":"عَلَّمَهُۥ شَدِیدُ ٱلۡقُوَىٰ\n","numberInSurah":5},{"number":53006,"text":"ذُو مِرَّةࣲ فَٱسۡتَوَىٰ\n","numberInSurah":6},{"number":53007,"text":"وَهُوَ بِٱلۡأُفُقِ ٱلۡأَعۡلَىٰ\n","numberInSurah":7},{"number":53008,"text":"ثُمَّ دَنَا فَتَدَلَّىٰ\n","numberInSurah":8},{"number":53009,"text":"فَكَانَ قَابَ قَوۡسَیۡنِ أَوۡ أَدۡنَىٰ\n","numberInSurah":9},{"number":53010,"text":"فَأَوۡحَىٰۤ إِلَىٰ عَبۡدِهِۦ مَاۤ أَوۡحَىٰ\n","numberInSurah":10},{"number":53011,"text":"مَا كَذَبَ ٱلۡفُؤَادُ مَا رَأَىٰۤ\n","numberInSurah":11},{"number":53012,"text":"أَفَتُمَـٰرُونَهُۥ عَلَىٰ مَا یَرَىٰ\n","numberInSurah":12},{"number":53013,"text":"وَلَقَدۡ رَءَاهُ نَزۡلَةً أُخۡرَىٰ\n","numberInSurah":13},{"number":53014,"text":"عِندَ سِدۡرَةِ ٱلۡمُنتَهَىٰ\n","numberInSurah":14},{"number":53015,"text":"عِندَهَا جَنَّةُ ٱلۡمَأۡوَىٰۤ\n","numberInSurah":15},{"number":53016,"text":"إِذۡ یَغۡشَى ٱلسِّدۡرَةَ مَا یَغۡشَىٰ\n","numberInSurah":16},{"number":53017,"text":"مَا زَاغَ ٱلۡبَصَرُ وَمَا طَغَىٰ\n","numberInSurah":17},{"number":53018,"text":"لَقَدۡ رَأَىٰ مِنۡ ءَایَـٰتِ رَبِّهِ ٱلۡكُبۡرَىٰۤ\n","numberInSurah":18},{"number":53019,"text":"أَفَرَءَیۡتُمُ ٱللَّـٰتَ وَٱلۡعُزَّىٰ\n","numberInSurah":19},{"number":53020,"text":"وَمَنَوٰةَ ٱلثَّالِثَةَ ٱلۡأُخۡرَىٰۤ\n","numberInSurah":20},{"number":53021,"text":"أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلۡأُنثَىٰ\n","numberInSurah":21},{"number":53022,"text":"تِلۡكَ إِذࣰا قِسۡمَةࣱ ضِیزَىٰۤ\n","numberInSurah":22},{"number":53023,"text":"إِنۡ هِیَ إِلَّاۤ أَسۡمَاۤءࣱ سَمَّیۡتُمُوهَاۤ أَنتُمۡ وَءَابَاۤؤُكُم مَّاۤ أَنزَلَ ٱللَّهُ بِهَا مِن سُلۡطَـٰنٍۚ إِن یَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهۡوَى ٱلۡأَنفُسُۖ وَلَقَدۡ جَاۤءَهُم مِّن رَّبِّهِمُ ٱلۡهُدَىٰۤ\n","numberInSurah":23},{"number":53024,"text":"أَمۡ لِلۡإِنسَـٰنِ مَا تَمَنَّىٰ\n","numberInSurah":24},{"number":53025,"text":"فَلِلَّهِ ٱلۡـَٔاخِرَةُ وَٱلۡأُولَىٰ\n","numberInSurah":25},{"number":53026,"text":"۞ وَكَم مِّن مَّلَكࣲ فِی ٱلسَّمَـٰوَ ٰ⁠تِ لَا تُغۡنِی شَفَـٰعَتُهُمۡ شَیۡـًٔا إِلَّا مِنۢ بَعۡدِ أَن یَأۡذَنَ ٱللَّهُ لِمَن یَشَاۤءُ وَیَرۡضَىٰۤ\n","numberInSurah":26},{"number":53027,"text":"إِنَّ ٱلَّذِینَ لَا یُؤۡمِنُونَ بِٱلۡـَٔاخِرَةِ لَیُسَمُّونَ ٱلۡمَلَـٰۤىِٕكَةَ تَسۡمِیَةَ ٱلۡأُنثَىٰ\n","numberInSurah":27},{"number":53028,"text":"وَمَا لَهُم بِهِۦ مِنۡ عِلۡمٍۖ إِن یَتَّبِعُونَ إِلَّا ٱلظَّنَّۖ وَإِنَّ ٱلظَّنَّ لَا یُغۡنِی مِنَ ٱلۡحَقِّ شَیۡـࣰٔا\n","numberInSurah":28},{"number":53029,"text":"فَأَعۡرِضۡ عَن مَّن تَوَلَّىٰ عَن ذِكۡرِنَا وَلَمۡ یُرِدۡ إِلَّا ٱلۡحَیَوٰةَ ٱلدُّنۡیَا\n","numberInSurah":29},{"number":53030,"text":"ذَ ٰ⁠لِكَ مَبۡلَغُهُم مِّنَ ٱلۡعِلۡمِۚ إِنَّ رَبَّكَ هُوَ أَعۡلَمُ بِمَن ضَلَّ عَن سَبِیلِهِۦ وَهُوَ أَعۡلَمُ بِمَنِ ٱهۡتَدَىٰ\n","numberInSurah":30},{"number":53031,"text":"وَلِلَّهِ مَا فِی ٱلسَّمَـٰوَ ٰ⁠تِ وَمَا فِی ٱلۡأَرۡضِ لِیَجۡزِیَ ٱلَّذِینَ أَسَـٰۤـُٔوا۟ بِمَا عَمِلُوا۟ وَیَجۡزِیَ ٱلَّذِینَ أَحۡسَنُوا۟ بِٱلۡحُسۡنَى\n","numberInSurah":31},{"number":53032,"text":"ٱلَّذِینَ یَجۡتَنِبُونَ كَبَـٰۤىِٕرَ ٱلۡإِثۡمِ وَٱلۡفَوَ ٰ⁠حِشَ إِلَّا ٱللَّمَمَۚ إِنَّ رَبَّكَ وَ ٰ⁠سِعُ ٱلۡمَغۡفِرَةِۚ هُوَ أَعۡلَمُ بِكُمۡ إِذۡ أَنشَأَكُم مِّنَ ٱلۡأَرۡضِ وَإِذۡ أَنتُمۡ أَجِنَّةࣱ فِی بُطُونِ أُمَّهَـٰتِكُمۡۖ فَلَا تُزَكُّوۤا۟ أَنفُسَكُمۡۖ هُوَ أَعۡلَمُ بِمَنِ ٱتَّقَىٰۤ\n","numberInSurah":32},{"number":53033,"text":"أَفَرَءَیۡتَ ٱلَّذِی تَوَلَّىٰ\n","numberInSurah":33},{"number":53034,"text":"وَأَعۡطَىٰ قَلِیلࣰا وَأَكۡدَىٰۤ\n","numberInSurah":34},{"number":53035,"text":"أَعِندَهُۥ عِلۡمُ ٱلۡغَیۡبِ فَهُوَ یَرَىٰۤ\n","numberInSurah":35},{"number":53036,"text":"أَمۡ لَمۡ یُنَبَّأۡ بِمَا فِی صُحُفِ مُوسَىٰ\n","numberInSurah":36},{"number":53037,"text":"وَإِبۡرَ ٰ⁠هِیمَ ٱلَّذِی وَفَّىٰۤ\n","numberInSurah":37},{"number":53038,"text":"أَلَّا تَزِرُ وَازِرَةࣱ وِزۡرَ أُخۡرَىٰ\n","numberInSurah":38},{"number":53039,"text":"وَأَن لَّیۡسَ لِلۡإِنسَـٰنِ إِلَّا مَا سَعَىٰ\n","numberInSurah":39},{"number":53040,"text":"وَأَنَّ سَعۡیَهُۥ سَوۡفَ یُرَىٰ\n","numberInSurah":40},{"number":53041,"text":"ثُمَّ یُجۡزَىٰهُ ٱلۡجَزَاۤءَ ٱلۡأَوۡفَىٰ\n","numberInSurah":41},{"number":53042,"text":"وَأَنَّ إِلَىٰ رَبِّكَ ٱلۡمُنتَهَىٰ\n","numberInSurah":42},{"number":53043,"text":"وَأَنَّهُۥ هُوَ أَضۡحَكَ وَأَبۡكَىٰ\n","numberInSurah":43},{"number":53044,"text":"وَأَنَّهُۥ هُوَ أَمَاتَ وَأَحۡیَا\n","numberInSurah":44},{"number":53045,"text":"وَأَنَّهُۥ خَلَقَ ٱلزَّوۡجَیۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰ\n","numberInSurah":45},{"number":53046,"text":"مِن نُّطۡفَةٍ إِذَا تُمۡنَىٰ\n","numberInSurah":46},{"number":53047,"text":"وَأَنَّ عَلَیۡهِ ٱلنَّشۡأَةَ ٱلۡأُخۡرَىٰ\n","numberInSurah":47},{"number":53048,"text":"وَأَنَّهُۥ هُوَ أَغۡنَىٰ وَأَقۡنَىٰ\n","numberInSurah":48},{"number":53049,"text":"وَأَنَّهُۥ هُوَ رَبُّ ٱلشِّعۡرَىٰ\n","numberInSurah":49},{"number":53050,"text":"وَأَنَّهُۥۤ أَهۡلَكَ عَادًا ٱلۡأُولَىٰ\n","numberInSurah":50},{"number":53051,"text":"وَثَمُودَا۟ فَمَاۤ أَبۡقَىٰ\n","numberInSurah":51},{"number":53052,"text":"وَقَوۡمَ نُوحࣲ مِّن قَبۡلُۖ إِنَّهُمۡ كَانُوا۟ هُمۡ أَظۡلَمَ وَأَطۡغَىٰ\n","numberInSurah":52},{"number":53053,"text":"وَٱلۡمُؤۡتَفِكَةَ أَهۡوَىٰ\n","numberInSurah":53},{"number":53054,"text":"فَغَشَّىٰهَا مَا غَشَّىٰ\n","numberInSurah":54},{"number":53055,"text":"فَبِأَیِّ ءَالَاۤءِ رَبِّكَ تَتَمَارَىٰ\n","numberInSurah":55},{"number":53056,"text":"هَـٰذَا نَذِیرࣱ مِّنَ ٱلنُّذُرِ ٱلۡأُولَىٰۤ\n","numberInSurah":56},{"number":53057,"text":"أَزِفَتِ ٱلۡـَٔازِفَةُ\n","numberInSurah":57},{"number":53058,"text":"لَیۡسَ لَهَا مِن دُونِ ٱللَّهِ كَاشِفَةٌ\n","numberInSurah":58},{"number":53059,"text":"أَفَمِنۡ هَـٰذَا ٱلۡحَدِیثِ تَعۡجَبُونَ\n","numberInSurah":59},{"number":53060,"text":"وَتَضۡحَكُونَ وَلَا تَبۡكُونَ\n","numberInSurah":60},{"number":53061,"text":"وَأَنتُمۡ سَـٰمِدُونَ\n","numberInSurah":61},{"number":53062,"text":"فَٱسۡجُدُوا۟ لِلَّهِ وَٱعۡبُدُوا۟ ۩\n","numberInSurah":62}]}}