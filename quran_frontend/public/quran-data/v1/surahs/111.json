{"data":{"number":111,"name":"سُورَةُ المَسَدِ","englishName":"Al-Masad","englishNameTranslation":"The Palm Fibre","numberOfAyahs":5,"revelationType":"Meccan","ayahs":[{"number":111001,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ تَبَّتۡ یَدَاۤ أَبِی لَهَبࣲ وَتَبَّ\n","numberInSurah":1},{"number":111002,"text":"مَاۤ أَغۡنَىٰ عَنۡهُ مَالُهُۥ وَمَا كَسَبَ\n","numberInSurah":2},{"number":111003,"text":"سَیَصۡلَىٰ نَارࣰا ذَاتَ لَهَبࣲ\n","numberInSurah":3},{"number":111004,"text":"وَٱمۡرَأَتُهُۥ حَمَّالَةَ ٱلۡحَطَبِ\n","numberInSurah":4},{"number":111005,"text":"فِی جِیدِهَا حَبۡلࣱ مِّن مَّسَدِۭ\n","numberInSurah":5}]}}